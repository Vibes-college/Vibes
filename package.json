{
  "name": "vibes-explore",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "check:types": "astro check && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "check": "npm run check:types && npm run lint && npm run format:check && npm run docs:check && npm run test:unit",
    "test": "npm run test:unit",
    "test:e2e": "node --experimental-strip-types scripts/test-e2e.ts",
    "db:reset": "node --experimental-strip-types scripts/database.ts reset",
    "db:migrate": "node --experimental-strip-types scripts/database.ts migrate",
    "preview": "npm run build && wrangler dev --local --config wrangler.local.jsonc --persist-to .wrangler/project-local --ip 127.0.0.1 --port 4322",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "verify": "npm run check && npm run db:reset && npm run test:e2e",
    "budget": "npm run build && node --experimental-strip-types scripts/budget.ts",
    "docs:check": "node --experimental-strip-types scripts/docs-check.ts",
    "ci:scope": "node --experimental-strip-types scripts/check-scope.ts"
  },
  "dependencies": {
    "astro": "7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.1",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "wrangler": "4.129.0"
  }
}
