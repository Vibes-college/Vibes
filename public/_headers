/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' wss://relay.paseo.sh; media-src 'self' blob: https://yaoda.work https://repo-sam.inria.fr; frame-src https://player.bilibili.com https://www.youtube-nocookie.com https://open.spotify.com https://gabrielecirulli.github.io https://ciechanow.ski https://yaoda.work; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/zh/*
  Cache-Control: public, max-age=60, must-revalidate
/en/*
  Cache-Control: public, max-age=60, must-revalidate
