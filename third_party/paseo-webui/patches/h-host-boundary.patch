--- /dev/null
+++ b/packages/app/src/embedded/ready.tsx
@@ -0,0 +1,19 @@
+import { useEffect } from "react";
+import { usePathname } from "expo-router";
+import { useHostRegistryLoaded } from "@/runtime/host-runtime";
+import { getEmbeddedHost } from "./environment";
+
+// Operable means the native startup route has yielded to its UI. Connection and
+// authoritative history readiness remain separate native states, never inferred here.
+export function EmbeddedReady() {
+  const path = usePathname();
+  const registryLoaded = useHostRegistryLoaded();
+  useEffect(() => {
+    if (!registryLoaded || path === "/") return;
+    const frame = requestAnimationFrame(() => {
+      getEmbeddedHost()?.onEvent({ version: 1, type: "ready" });
+    });
+    return () => cancelAnimationFrame(frame);
+  }, [path, registryLoaded]);
+  return null;
+}
