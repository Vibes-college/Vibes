+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { JSDOM } from "jsdom";
+import AsyncStorage from "@react-native-async-storage/async-storage";
+import { createDraftPersistStorage } from "@/stores/draft-store/persistence";
+import { createValidatedPersistStorage } from "@/storage/validated-persist-storage";
+import { DraftStoreStateSchema, type DraftStoreState } from "@/stores/draft-store/state";
+
+let dom: JSDOM;
+beforeEach(() => {
+  dom = new JSDOM("<!doctype html>", { url: "https://vibes.college" });
+  vi.stubGlobal("window", dom.window);
+  vi.resetModules();
+});
+afterEach(() => {
+  dom.window.close();
+  vi.unstubAllGlobals();
+});
+
+it("restores each native workspace selection through the real AsyncStorage web adapter after module reload", async () => {
+  let product = await import("./product-mode");
+  await product.hydrateProductMode();
+  product.rememberProductWorkspace("chat", { serverId: "home", workspaceId: "chat-workspace" });
+  product.setProductMode("build");
+  product.rememberProductWorkspace("build", {
+    serverId: "office",
+    workspaceId: "existing-project",
+  });
+  product.setProductMode("chat");
+  expect(window.localStorage.getItem("vibes-product-mode-v1")).toContain("existing-project");
+  vi.resetModules();
+  product = await import("./product-mode");
+  await product.hydrateProductMode();
+  expect(product.getProductDestination("chat")).toEqual({
+    kind: "workspace",
+    selection: { serverId: "home", workspaceId: "chat-workspace" },
+  });
+  expect(product.getProductDestination("build")).toEqual({
+    kind: "workspace",
+    selection: { serverId: "office", workspaceId: "existing-project" },
+  });
+  expect(product.getProductMode().mode).toBe("chat");
+});
+it("restores a Build picker draft route instead of changing to the previous workspace", async () => {
+  let product = await import("./product-mode");
+  await product.hydrateProductMode();
+  product.rememberProductWorkspace("build", { serverId: "office", workspaceId: "previous" });
+  const entry = {
+    pathname: "/new" as const,
+    params: {
+      serverId: "office",
+      projectId: "p-2",
+      dir: "/projects/second",
+      draftId: "draft-original",
+    },
+  };
+  product.rememberBuildEntry(entry);
+  product.setProductMode("chat");
+  vi.resetModules();
+  product = await import("./product-mode");
+  await product.hydrateProductMode();
+  expect(product.getProductDestination("build")).toEqual({ kind: "picker", entry });
+  product.rememberProductWorkspace("build", { serverId: "office", workspaceId: "created" });
+  expect(product.getProductDestination("build")).toEqual({
+    kind: "workspace",
+    selection: { serverId: "office", workspaceId: "created" },
+  });
+});
+it("persists uncertain preparation by host before a reload", async () => {
+  let product = await import("./product-mode");
+  await product.hydrateProductMode();
+  const pending = { cwd: "/home/test/Vibes", projectId: "project", phase: "opening" as const };
+  await product.saveChatPreparation("host-a", pending);
+  vi.resetModules();
+  product = await import("./product-mode");
+  await expect(product.readChatPreparation("host-a")).resolves.toEqual(pending);
+  await expect(product.readChatPreparation("host-b")).resolves.toBeNull();
+});
+it("round-trips native draft text and article deletion through native persistence and localStorage", async () => {
+  const backing = () =>
+    createDraftPersistStorage(createValidatedPersistStorage(AsyncStorage, DraftStoreStateSchema));
+  const key = "native-article-draft-test";
+  const state: DraftStoreState = {
+    createModalDraft: null,
+    drafts: {
+      "agent:host:existing": {
+        lifecycle: "active",
+        updatedAt: Date.now(),
+        version: 1,
+        input: {
+          text: "Keep this existing question",
+          attachments: [
+            {
+              kind: "vibes_public_work",
+              reference: {
+                requestId: "explicit-article",
+                id: "example",
+                title: "Example",
+                canonicalUrl: "https://vibes.college/zh/works/example/",
+              },
+            },
+          ],
+        },
+      },
+    },
+  };
+  const first = backing();
+  await first.setItem(key, { state, version: 5 });
+  await first.flush();
+  expect((await backing().getItem(key))?.state.drafts["agent:host:existing"].input).toEqual(
+    state.drafts["agent:host:existing"].input,
+  );
+  state.drafts["agent:host:existing"].input.attachments = [];
+  await first.setItem(key, { state, version: 5 });
+  await first.flush();
+  const restored = (await backing().getItem(key))?.state.drafts["agent:host:existing"].input;
+  expect(restored).toEqual({ text: "Keep this existing question", attachments: [] });
+});
