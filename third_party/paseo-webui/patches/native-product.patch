@@ -0,0 +1,37 @@
+/** Sandboxed carrier frames have an opaque origin. Match the exact browsing
+ * context and one-use token before handing it the already-opened local file. */
+export function deliverHtmlToCarrier(input: {
+  event: MessageEvent;
+  frameWindow: Window | null;
+  token: string;
+  html: string;
+  delivered: boolean;
+  markDelivered(): void;
+}): boolean {
+  if (
+    input.delivered ||
+    !input.frameWindow ||
+    input.event.source !== input.frameWindow ||
+    input.event.origin !== "null"
+  )
+    return false;
+  const value: unknown = input.event.data;
+  if (!value || typeof value !== "object" || Array.isArray(value)) return false;
+  const record = value as Record<string, unknown>;
+  const keys = Object.keys(record);
+  if (
+    keys.length !== 3 ||
+    !keys.every((key) => ["version", "type", "token"].includes(key)) ||
+    record.version !== 1 ||
+    record.type !== "vibes-html-ready" ||
+    record.token !== input.token
+  )
+    return false;
+  input.markDelivered();
+  // '*' is required for an opaque origin; the source check above pins the receiver.
+  input.frameWindow.postMessage(
+    { version: 1, type: "vibes-html-content", token: input.token, html: input.html },
