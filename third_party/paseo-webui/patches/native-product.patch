+import { type ReactNode, useEffect } from "react";
+import { Pressable, Text, View } from "react-native";
+import { usePathname, useRouter, type Href } from "expo-router";
+import { useUnistyles } from "react-native-unistyles";
+import { useTranslation } from "react-i18next";
+import { SidebarMenuToggle } from "@/components/headers/menu-header";
+import { ScreenHeader } from "@/components/headers/screen-header";
+import { navigateToHostWorkspaceRoute } from "@/navigation/workspace-route-navigation";
+import { buildHostWorkspaceRoute } from "@/utils/host-routes";
+import { getEmbeddedHost } from "./environment";
+import {
+  getProductMode,
+  getProductDestination,
+  rememberProductWorkspace,
+  setProductMode,
+  useProductMode,
+  type ProductMode,
+} from "./product-mode";
+
+export function ProductHeader({
+  serverId,
+  workspaceId,
+  right,
+  onNewConversation,
+  active = true,
+  showMenu = true,
+}: {
+  serverId?: string;
+  workspaceId?: string;
+  right?: ReactNode;
+  onNewConversation?: () => void;
+  active?: boolean;
+  showMenu?: boolean;
+}) {
+  const { theme } = useUnistyles();
+  const router = useRouter();
+  const pathname = usePathname();
+  const { mode } = useProductMode();
+  const { i18n } = useTranslation();
+  const zh = i18n.language.startsWith("zh");
+  useEffect(() => {
+    if (!active || !serverId || !workspaceId) return;
+    const current = getProductMode();
+    if (
+      current.mode === "chat" &&
+      (current.chat?.serverId !== serverId || current.chat?.workspaceId !== workspaceId)
+    ) {
+      setProductMode("build");
+    }
+    rememberProductWorkspace(getProductMode().mode, { serverId, workspaceId });
+    // A mode change alone must not label the departing workspace as the destination.
+  }, [active, serverId, workspaceId]);
+  if (!getEmbeddedHost()) return null;
+  const select = (next: ProductMode) => {
+    if (next === mode && (workspaceId || pathname === "/new" || pathname === "/vibes-chat")) return;
+    setProductMode(next, serverId && workspaceId ? { serverId, workspaceId } : null);
+    const destination = getProductDestination(next);
+    if (destination.kind === "workspace") {
+      const { serverId: hostId, workspaceId: workspace } = destination.selection;
+      navigateToHostWorkspaceRoute(buildHostWorkspaceRoute(hostId, workspace));
+    } else if (destination.kind === "picker") router.navigate(destination.entry as Href);
+    else router.navigate("/vibes-chat" as Href);
+  };
+  return (
+    <ScreenHeader
+      left={
+        <>
+          {showMenu ? <SidebarMenuToggle /> : null}
+          <View style={{ flexDirection: "row", gap: 4 }} accessibilityRole="tablist">
+            {(["chat", "build"] as const).map((item) => (
+              <Pressable
+                key={item}
+                accessibilityRole="tab"
+                accessibilityState={{ selected: mode === item }}
+                accessibilityLabel={item === "chat" ? "Chat" : "Build"}
+                onPress={() => select(item)}
+                style={{
+                  minHeight: 44,
+                  minWidth: 64,
+                  paddingHorizontal: 12,
+                  justifyContent: "center",
+                  borderBottomWidth: 2,
+                  borderBottomColor: mode === item ? theme.colors.foreground : "transparent",
+                }}
+              >
+                <Text
+                  style={{
+                    color: mode === item ? theme.colors.foreground : theme.colors.foregroundMuted,
+                    fontWeight: mode === item ? "600" : "400",
+                    fontSize: 14,
+                  }}
+                >
+                  {item === "chat" ? "Chat" : "Build"}
+                </Text>
+              </Pressable>
+            ))}
+          </View>
+        </>
+      }
+      right={
+        <>
+          {onNewConversation ? (
+            <Pressable
+              accessibilityRole="button"
+              accessibilityLabel={zh ? "新对话" : "New conversation"}
+              onPress={onNewConversation}
+              style={{
+                minWidth: 44,
+                minHeight: 44,
+                alignItems: "center",
+                justifyContent: "center",
+              }}
+            >
+              <Text style={{ color: theme.colors.foreground, fontSize: 24 }}>+</Text>
+            </Pressable>
+          ) : null}
+          {right}
+          {mode === "build" ? (
+            <Pressable
+              accessibilityRole="button"
+              accessibilityLabel={zh ? "选择项目" : "Choose project"}
+              onPress={() => router.push("/new")}
+              style={{
+                minWidth: 44,
+                minHeight: 44,
+                justifyContent: "center",
+                paddingHorizontal: 8,
+              }}
+            >
+              <Text style={{ color: theme.colors.foregroundMuted }}>
+                {zh ? "项目" : "Projects"}
+              </Text>
+            </Pressable>
+          ) : null}
+        </>
+      }
+    />
+  );
+}
