+import React, { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { JSDOM } from "jsdom";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { FileHtmlPreview } from "./html-preview.web";
+
+vi.mock("react-i18next", () => ({
+  useTranslation: () => ({ t: (key: string) => key, i18n: { language: "en" } }),
+}));
+let root: Root;
+let dom: JSDOM;
+beforeEach(() => {
+  dom = new JSDOM("<!doctype html><div id='root'></div>", { url: "https://vibes.college" });
+  vi.stubGlobal("window", dom.window);
+  vi.stubGlobal("document", dom.window.document);
+  vi.stubGlobal("React", React);
+  vi.stubGlobal("IS_REACT_ACT_ENVIRONMENT", true);
+  vi.stubGlobal("__vibesPaseoEnvironment", {});
+  vi.stubEnv("EXPO_PUBLIC_VIBES_HTML_PREVIEW_CARRIER", "/paseo-preview/");
+  root = createRoot(document.getElementById("root")!);
+});
+afterEach(() => {
+  act(() => root.unmount());
+  dom.window.close();
+  vi.unstubAllGlobals();
+  vi.unstubAllEnvs();
+});
+function signalReady(frame: HTMLIFrameElement, token: string) {
+  act(() =>
+    window.dispatchEvent(
+      new dom.window.MessageEvent("message", {
+        source: frame.contentWindow,
+        origin: "null",
+        data: { version: 1, type: "vibes-html-ready", token },
+      }),
+    ),
+  );
+}
+it("uses a separate response, one-use init handshake, and retains the original sandbox and CSP", () => {
+  act(() =>
+    root.render(<FileHtmlPreview html="<button onclick='this.textContent=2'>1</button>" />),
+  );
+  const frame = document.querySelector("iframe")!;
+  expect(frame.getAttribute("src")).toBe("/paseo-preview/");
+  expect(frame.hasAttribute("srcdoc")).toBe(false);
+  expect(frame.getAttribute("sandbox")).toBe("allow-scripts");
+  const post = vi.spyOn(frame.contentWindow!, "postMessage").mockImplementation(() => {});
+  act(() => frame.dispatchEvent(new dom.window.Event("load")));
+  const init = post.mock.calls[0][0] as { type: string; token: string };
+  expect(init.type).toBe("vibes-html-init");
+  expect(frame.src).not.toContain(init.token);
+  signalReady(frame, init.token);
+  expect(post.mock.calls[1][0]).toMatchObject({
+    type: "vibes-html-content",
+    token: init.token,
+    html: expect.stringContaining("Content-Security-Policy"),
+  });
+  act(() => frame.dispatchEvent(new dom.window.Event("load")));
+  signalReady(frame, init.token);
+  expect(post).toHaveBeenCalledTimes(2);
+});
+it("replaces the browsing context for changed file content and rejects the old window", () => {
+  act(() => root.render(<FileHtmlPreview html="<h1>First</h1>" />));
+  const first = document.querySelector("iframe")!;
+  const firstPost = vi.spyOn(first.contentWindow!, "postMessage").mockImplementation(() => {});
+  act(() => first.dispatchEvent(new dom.window.Event("load")));
+  const oldToken = (firstPost.mock.calls[0][0] as { token: string }).token;
+  act(() => root.render(<FileHtmlPreview html="<h1>Second</h1>" />));
+  const second = document.querySelector("iframe")!;
+  expect(second).not.toBe(first);
+  const secondPost = vi.spyOn(second.contentWindow!, "postMessage").mockImplementation(() => {});
+  signalReady(first, oldToken);
+  expect(secondPost).not.toHaveBeenCalled();
+  act(() => second.dispatchEvent(new dom.window.Event("load")));
+  const newToken = (secondPost.mock.calls[0][0] as { token: string }).token;
+  expect(newToken).not.toBe(oldToken);
+  signalReady(second, newToken);
+  expect(secondPost.mock.calls[1][0]).toMatchObject({ html: expect.stringContaining("Second") });
+});
+it("keeps the official srcDoc preview outside the embedded product", () => {
+  vi.stubGlobal("__vibesPaseoEnvironment", undefined);
+  act(() => root.render(<FileHtmlPreview html="<h1>Native</h1>" />));
+  const frame = document.querySelector("iframe")!;
+  expect(frame.getAttribute("srcdoc")).toContain("<h1>Native</h1>");
+  expect(frame.hasAttribute("src")).toBe(false);
+});
