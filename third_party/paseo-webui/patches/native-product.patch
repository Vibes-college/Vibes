@@ -0,0 +1,52 @@
+import { expect, it, vi } from "vitest";
+import { deliverHtmlToCarrier } from "./html-preview-carrier";
+import { withPreviewCsp } from "@/file-pane/html-preview-csp";
+
+it("delivers only the original native-CSP document to the exact opaque carrier once", () => {
+  const postMessage = vi.fn();
+  const frameWindow = { postMessage } as unknown as Window;
+  const data = { version: 1, type: "vibes-html-ready", token: "fresh-document" };
+  const input = {
+    event: { source: frameWindow, origin: "null", data } as unknown as MessageEvent,
+    frameWindow,
+    token: "fresh-document",
+    html: withPreviewCsp("<button onclick='this.textContent=2'>1</button>"),
+    delivered: false,
+    markDelivered: vi.fn(),
+  };
+  expect(deliverHtmlToCarrier(input)).toBe(true);
+  expect(postMessage).toHaveBeenCalledWith(
+    { version: 1, type: "vibes-html-content", token: input.token, html: input.html },
+    "*",
+  );
+  expect(deliverHtmlToCarrier({ ...input, delivered: true })).toBe(false);
+  expect(input.markDelivered).toHaveBeenCalledTimes(1);
+  expect(postMessage).toHaveBeenCalledTimes(1);
+});
+it("rejects foreign windows, navigated origins, stale tokens, and extra fields", () => {
+  const postMessage = vi.fn();
+  const frameWindow = { postMessage } as unknown as Window;
+  const good = {
+    source: frameWindow,
+    origin: "null",
+    data: { version: 1, type: "vibes-html-ready", token: "current" },
+  };
+  for (const event of [
+    { ...good, source: {} },
+    { ...good, origin: "https://remote.example" },
+    { ...good, data: { ...good.data, token: "old" } },
+    { ...good, data: { ...good.data, action: "read-other-files" } },
+    { ...good, data: null },
+  ])
+    expect(
+      deliverHtmlToCarrier({
+        event: event as unknown as MessageEvent,
+        frameWindow,
+        token: "current",
+        html: "private local file",
+        delivered: false,
+        markDelivered: vi.fn(),
+      }),
+    ).toBe(false);
+  expect(postMessage).not.toHaveBeenCalled();
+});
