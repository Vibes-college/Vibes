@@ -0,0 +1,171 @@
+import { describe, expect, it, vi } from "vitest";
+import type { ProviderSnapshotEntry } from "@getpaseo/protocol/agent-types";
+import {
+  ChatPresetInitializer,
+  resolveChatSetup,
+  type ChatPreparation,
+  type ChatPresetDependencies,
+} from "./chat-preset";
+
+const cwd = "/home/test/Vibes";
+const workspace = { id: "workspace-chat", projectId: "project-chat", workspaceDirectory: cwd };
+const entries: ProviderSnapshotEntry[] = [
+  {
+    provider: "codex",
+    enabled: true,
+    status: "ready",
+    models: [
+      {
+        provider: "codex",
+        id: "model-from-daemon",
+        aliases: ["gpt-5.6-luna"],
+        label: "Luna",
+        thinkingOptions: [
+          { id: "medium", label: "Medium" },
+          { id: "high", label: "High" },
+        ],
+        defaultThinkingOptionId: "medium",
+      },
+    ],
+  },
+];
+function fixture(initial: ChatPreparation | null = null) {
+  let saved = initial;
+  const methods = {
+    createProjectDirectory: vi.fn(async () => ({
+      directoryPath: cwd,
+      error: null,
+      errorCode: null,
+    })),
+    addProject: vi.fn(async () => ({ project: { projectId: "project-chat" }, error: null })),
+    fetchWorkspaces: vi.fn(async () => ({
+      entries: [] as (typeof workspace)[],
+      pageInfo: { hasMore: false, nextCursor: null },
+    })),
+    openProject: vi.fn(async () => ({ workspace, error: null })),
+    getProvidersSnapshot: vi.fn(async () => ({ entries })),
+  };
+  const deps: ChatPresetDependencies = {
+    client: methods as unknown as ChatPresetDependencies["client"],
+    read: async () => saved,
+    save: async (value) => {
+      saved = value;
+    },
+  };
+  return { methods, deps, getSaved: () => saved };
+}
+describe("Chat native preset", () => {
+  it("selects only the real selectable Luna id and its native default strength", () => {
+    expect(resolveChatSetup(entries, cwd)).toMatchObject({
+      cwd,
+      provider: "codex",
+      model: "model-from-daemon",
+      thinkingOptionId: "medium",
+    });
+    expect(() => resolveChatSetup([{ ...entries[0], enabled: false }], cwd)).toThrow("Codex");
+    expect(() => resolveChatSetup([{ ...entries[0], status: "loading" }], cwd)).toThrow("Codex");
+    expect(() =>
+      resolveChatSetup(
+        [{ ...entries[0], models: [{ ...entries[0].models![0], isSelectable: false }] }],
+        cwd,
+      ),
+    ).toThrow("Luna");
+    expect(() => resolveChatSetup([{ ...entries[0], models: [] }], cwd)).toThrow("Luna");
+  });
+  it("prepares a normal directory and workspace once for concurrent entry, without creating an agent", async () => {
+    const f = fixture();
+    const initializer = new ChatPresetInitializer();
+    const first = initializer.run("host", f.deps);
+    expect(initializer.run("host", f.deps)).toBe(first);
+    await expect(first).resolves.toMatchObject({
+      workspace,
+      setup: { model: "model-from-daemon", cwd },
+    });
+    expect(f.methods.createProjectDirectory).toHaveBeenCalledWith({
+      parentPath: "~",
+      name: "Vibes",
+    });
+    expect(f.methods.openProject).toHaveBeenCalledTimes(1);
+    expect(f.methods.getProvidersSnapshot).toHaveBeenCalledWith({ cwd });
+    expect(f.getSaved()).toMatchObject({ phase: "ready", workspaceId: workspace.id });
+  });
+  it("validates an existing path and reuses its workspace", async () => {
+    const f = fixture();
+    f.methods.createProjectDirectory.mockResolvedValueOnce({
+      directoryPath: cwd,
+      error: "exists" as never,
+      errorCode: "directory_exists" as never,
+    });
+    f.methods.fetchWorkspaces.mockResolvedValueOnce({
+      entries: [workspace],
+      pageInfo: { hasMore: false, nextCursor: null },
+    });
+    await new ChatPresetInitializer().run("host", f.deps);
+    expect(f.methods.addProject).toHaveBeenCalledWith(cwd);
+    expect(f.methods.openProject).not.toHaveBeenCalled();
+  });
+  it("rejects non-directory paths and permission errors without opening workspaces", async () => {
+    const file = fixture();
+    file.methods.createProjectDirectory.mockResolvedValueOnce({
+      directoryPath: cwd,
+      error: "exists" as never,
+      errorCode: "directory_exists" as never,
+    });
+    file.methods.addProject.mockResolvedValueOnce({
+      project: null as never,
+      error: "Not a directory" as never,
+    });
+    await expect(new ChatPresetInitializer().run("host", file.deps)).rejects.toThrow(
+      "Not a directory",
+    );
+    expect(file.methods.openProject).not.toHaveBeenCalled();
+    const denied = fixture();
+    denied.methods.createProjectDirectory.mockResolvedValueOnce({
+      directoryPath: null as never,
+      error: "Permission denied" as never,
+      errorCode: "permission_denied" as never,
+    });
+    await expect(new ChatPresetInitializer().run("host", denied.deps)).rejects.toThrow(
+      "Permission denied",
+    );
+    expect(denied.methods.addProject).not.toHaveBeenCalled();
+  });
+  it("queries an uncertain previous open and never blindly repeats it", async () => {
+    const f = fixture();
+    const initializer = new ChatPresetInitializer();
+    f.methods.openProject.mockRejectedValueOnce(new Error("connection lost"));
+    await expect(initializer.run("host", f.deps)).rejects.toThrow("connection lost");
+    expect(f.getSaved()?.phase).toBe("opening");
+    await expect(initializer.run("host", f.deps)).rejects.toMatchObject({
+      issue: "unknown-workspace",
+    });
+    expect(f.methods.openProject).toHaveBeenCalledTimes(1);
+    f.methods.fetchWorkspaces.mockResolvedValueOnce({
+      entries: [workspace],
+      pageInfo: { hasMore: false, nextCursor: null },
+    });
+    await expect(initializer.run("host", f.deps)).resolves.toMatchObject({ workspace });
+    expect(f.methods.openProject).toHaveBeenCalledTimes(1);
+  });
+  it("requires the pending state to persist before the non-idempotent open", async () => {
+    const f = fixture({ cwd, projectId: "project-chat", phase: "directory" });
+    f.deps.save = async () => {
+      throw new Error("storage unavailable");
+    };
+    await expect(new ChatPresetInitializer().run("host", f.deps)).rejects.toThrow(
+      "storage unavailable",
+    );
+    expect(f.methods.openProject).not.toHaveBeenCalled();
+  });
+  it("isolates simultaneous preparations by host", async () => {
+    const a = fixture();
+    const b = fixture();
+    const initializer = new ChatPresetInitializer();
+    const first = initializer.run("a", a.deps);
+    const second = initializer.run("b", b.deps);
+    expect(first).not.toBe(second);
+    await Promise.all([first, second]);
+    expect(a.methods.openProject).toHaveBeenCalledTimes(1);
+    expect(b.methods.openProject).toHaveBeenCalledTimes(1);
+  });
+});
