+      <View
+        style={{
+          flex: 1,
+          padding: 24,
+          justifyContent: "center",
+          gap: 16,
+          backgroundColor: theme.colors.surface0,
+        }}
+      >
+        <Text
+          accessibilityRole="header"
+          style={{ fontSize: 20, fontWeight: "600", color: theme.colors.foreground }}
+        >
+          Chat
+        </Text>
+        <Text style={{ color: theme.colors.foregroundMuted, lineHeight: 22 }}>{message}</Text>
+        {hosts.find((host) => host.serverId === serverId)?.label ? (
+          <Text style={{ color: theme.colors.foregroundMuted }}>
+            {hosts.find((host) => host.serverId === serverId)!.label}
+          </Text>
+        ) : null}
+        <View style={{ flexDirection: "row", flexWrap: "wrap", gap: 8 }}>
+          {error && connected
+            ? button(zh ? "重试" : "Retry", () => setAttempt((value) => value + 1))
+            : null}
+          {error
+            ? button(zh ? "选择 Agent / 项目" : "Choose agent / project", () => {
+                setProductMode("build");
+                router.push("/new");
+              })
+            : null}
+          {!connected || error
+            ? button(zh ? "连接设置" : "Connection settings", () =>
+                router.push(
+                  (serverId
+                    ? `/settings/hosts/${encodeURIComponent(serverId)}`
+                    : "/welcome") as Href,
+                ),
+              )
+            : null}
+        </View>
+      </View>
+    </View>
+  );
+}
