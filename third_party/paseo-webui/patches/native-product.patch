index 0000000..c68c383
--- /dev/null
+++ b/packages/app/src/embedded/product-mode.ts
@@ -0,0 +1,123 @@
+import AsyncStorage from "@react-native-async-storage/async-storage";
+import { useSyncExternalStore } from "react";
+import { z } from "zod";
+import type { ActiveWorkspaceSelection } from "@/stores/last-workspace-selection";
+import type { ChatPreparation } from "./chat-preset";
+
+export type ProductMode = "chat" | "build";
+const selectionSchema = z.object({ serverId: z.string().min(1), workspaceId: z.string().min(1) });
+const buildEntrySchema = z.object({
+  pathname: z.enum(["/new", "/open-project"]),
+  params: z.object({
+    serverId: z.string().optional(),
+    dir: z.string().optional(),
+    name: z.string().optional(),
+    projectId: z.string().optional(),
+    draftId: z.string().optional(),
+  }),
+});
+export type BuildEntry = z.infer<typeof buildEntrySchema>;
+const modeSchema = z.object({
+  mode: z.enum(["chat", "build"]),
+  chat: selectionSchema.nullable(),
+  build: selectionSchema.nullable(),
+  buildEntry: buildEntrySchema.nullable().default(null),
+});
+const preparationSchema = z.object({
+  cwd: z.string().min(1),
+  projectId: z.string().min(1),
+  phase: z.enum(["directory", "opening", "ready"]),
+  workspaceId: z.string().min(1).optional(),
+});
+const key = "vibes-product-mode-v1";
+let state: z.infer<typeof modeSchema> & { hydrated: boolean } = {
+  mode: "chat",
+  chat: null,
+  build: null,
+  buildEntry: null,
+  hydrated: false,
+};
+const listeners = new Set<() => void>();
+function publish() {
+  listeners.forEach((listener) => listener());
+}
+function persist() {
+  const { hydrated: _, ...value } = state;
+  void AsyncStorage.setItem(key, JSON.stringify(value)).catch(() => {});
+}
+let hydration: Promise<void> | null = null;
+export function hydrateProductMode(): Promise<void> {
+  if (hydration) return hydration;
+  hydration = (async () => {
+    try {
+      const raw = await AsyncStorage.getItem(key);
+      const parsed = raw ? modeSchema.safeParse(JSON.parse(raw)) : null;
+      if (parsed?.success) state = { ...parsed.data, hydrated: true };
+    } catch {
+      /* Navigation preferences may be absent; native drafts are independent. */
+    }
+    state = { ...state, hydrated: true };
+    publish();
+  })();
+  return hydration;
+}
+export function useProductMode() {
+  return useSyncExternalStore(
+    (listener) => {
+      listeners.add(listener);
+      return () => listeners.delete(listener);
+    },
+    () => state,
+    () => state,
+  );
+}
+export function getProductMode() {
+  return state;
+}
+export function setProductMode(mode: ProductMode, current?: ActiveWorkspaceSelection | null) {
+  state = { ...state, ...(current ? { [state.mode]: current } : {}), mode };
+  publish();
+  persist();
+}
+export function rememberProductWorkspace(mode: ProductMode, selection: ActiveWorkspaceSelection) {
+  if (
+    state[mode]?.serverId === selection.serverId &&
+    state[mode]?.workspaceId === selection.workspaceId &&
+    (mode !== "build" || state.buildEntry === null)
+  )
+    return;
+  state = { ...state, [mode]: selection, ...(mode === "build" ? { buildEntry: null } : {}) };
+  publish();
+  persist();
+}
+/** Keep only the native picker location. Text, attachments and tab state stay in Paseo stores. */
+export function rememberBuildEntry(entry: BuildEntry) {
+  const parsed = buildEntrySchema.parse(entry);
+  if (state.mode === "build" && JSON.stringify(state.buildEntry) === JSON.stringify(parsed)) return;
+  state = { ...state, mode: "build", buildEntry: parsed };
+  publish();
+  persist();
+}
+export function getProductDestination(mode: ProductMode) {
+  if (mode === "build" && state.buildEntry)
+    return { kind: "picker" as const, entry: state.buildEntry };
+  const selection = state[mode];
+  if (selection) return { kind: "workspace" as const, selection };
+  return mode === "chat"
+    ? { kind: "chat-start" as const }
+    : { kind: "picker" as const, entry: { pathname: "/new" as const, params: {} } };
+}
+const preparationKey = (serverId: string) => `vibes-chat-preparation-v1:${serverId}`;
+export async function readChatPreparation(serverId: string): Promise<ChatPreparation | null> {
+  const raw = await AsyncStorage.getItem(preparationKey(serverId));
+  if (!raw) return null;
+  const parsed = preparationSchema.safeParse(JSON.parse(raw));
+  if (!parsed.success)
+    throw new Error("Saved Chat preparation is invalid. Open the native project picker.");
+  return parsed.data;
+}
+export async function saveChatPreparation(serverId: string, value: ChatPreparation): Promise<void> {
+  // This write must complete before openProject; a refresh must retain uncertain state.
+  await AsyncStorage.setItem(preparationKey(serverId), JSON.stringify(value));
+}
+void hydrateProductMode();
