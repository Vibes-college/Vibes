index 0000000..5493b44
--- /dev/null
+++ b/packages/app/src/embedded/chat-preset.ts
@@ -0,0 +1,157 @@
+import type { ProviderSnapshotEntry } from "@getpaseo/protocol/agent-types";
+import type { DaemonClient } from "@getpaseo/client/internal/daemon-client";
+import type { WorkspaceDraftTabSetup } from "@/workspace-tabs/model";
+import { filterSelectableModels, findModelByReference } from "@/provider-selection/model-catalog";
+
+export const CHAT_DIRECTORY_NAME = "Vibes";
+export type ChatPresetIssue =
+  | "directory"
+  | "codex-unavailable"
+  | "luna-unavailable"
+  | "unknown-workspace";
+export class ChatPresetError extends Error {
+  constructor(
+    readonly issue: ChatPresetIssue,
+    message: string,
+  ) {
+    super(message);
+  }
+}
+
+export interface ChatPreparation {
+  cwd: string;
+  projectId: string;
+  phase: "directory" | "opening" | "ready";
+  workspaceId?: string;
+}
+
+type PresetClient = Pick<
+  DaemonClient,
+  | "createProjectDirectory"
+  | "addProject"
+  | "openProject"
+  | "fetchWorkspaces"
+  | "getProvidersSnapshot"
+>;
+export interface ChatPresetDependencies {
+  client: PresetClient;
+  read(): Promise<ChatPreparation | null>;
+  save(value: ChatPreparation): Promise<void>;
+}
+
+export function resolveChatSetup(
+  entries: ProviderSnapshotEntry[],
+  cwd: string,
+): WorkspaceDraftTabSetup {
+  const codex = entries.find((entry) => entry.provider === "codex");
+  if (!codex?.enabled || codex.status !== "ready") {
+    throw new ChatPresetError(
+      "codex-unavailable",
+      "Codex is not installed, signed in, or available on this computer.",
+    );
+  }
+  const models = filterSelectableModels(codex.models ?? null);
+  const luna = findModelByReference(models, "gpt-5.6-luna") ?? findModelByReference(models, "luna");
+  if (!luna)
+    throw new ChatPresetError(
+      "luna-unavailable",
+      "Luna is not available in this computer's Codex model list.",
+    );
+  const thinking = luna.thinkingOptions ?? [];
+  const thinkingOptionId =
+    thinking.find((option) => option.id === luna.defaultThinkingOptionId)?.id ??
+    thinking.find((option) => option.isDefault)?.id ??
+    null;
+  return {
+    provider: "codex",
+    cwd,
+    model: luna.id,
+    thinkingOptionId,
+    modeId: codex.defaultModeId ?? null,
+    featureValues: {},
+  };
+}
+
+/** One preparation per host in this module. RPC ids are correlations, not
+ * idempotency keys: after an uncertain open, query and never replay that write. */
+export class ChatPresetInitializer {
+  private readonly pending = new Map<string, Promise<Awaited<ReturnType<typeof prepare>>>>();
+  run(serverId: string, deps: ChatPresetDependencies) {
+    const current = this.pending.get(serverId);
+    if (current) return current;
+    const promise = prepare(deps).finally(() => {
+      if (this.pending.get(serverId) === promise) this.pending.delete(serverId);
+    });
+    this.pending.set(serverId, promise);
+    return promise;
+  }
+}
+
+async function prepare({ client, read, save }: ChatPresetDependencies) {
+  let saved = await read();
+  if (!saved) {
+    const directory = await client.createProjectDirectory({
+      parentPath: "~",
+      name: CHAT_DIRECTORY_NAME,
+    });
+    if (
+      !directory.directoryPath ||
+      (directory.error && directory.errorCode !== "directory_exists")
+    ) {
+      throw new ChatPresetError(
+        "directory",
+        directory.error ?? "The default folder could not be prepared.",
+      );
+    }
+    // EEXIST also covers a file. The official project API checks directory type.
+    const checked = await client.addProject(directory.directoryPath);
+    if (!checked.project || checked.error)
+      throw new ChatPresetError(
+        "directory",
+        checked.error ?? "The default path is not a usable directory.",
+      );
+    saved = {
+      cwd: directory.directoryPath,
+      projectId: checked.project.projectId,
+      phase: "directory",
+    };
+    await save(saved);
+  }
+  let cursor: string | undefined;
+  let workspace: Awaited<ReturnType<PresetClient["openProject"]>>["workspace"] = null;
+  do {
+    const page = await client.fetchWorkspaces({
+      filter: { projectId: saved.projectId },
+      page: { limit: 200, ...(cursor ? { cursor } : {}) },
+    });
+    workspace =
+      page.entries.find(
+        (entry) =>
+          entry.workspaceDirectory === saved.cwd &&
+          (!saved.workspaceId || entry.id === saved.workspaceId),
+      ) ?? null;
+    cursor = page.pageInfo.hasMore ? (page.pageInfo.nextCursor ?? undefined) : undefined;
+  } while (!workspace && cursor);
+  if (!workspace) {
+    if (saved.phase !== "directory") {
+      throw new ChatPresetError(
+        "unknown-workspace",
+        "The previous workspace preparation has not been confirmed. Check the native project list before creating another workspace.",
+      );
+    }
+    await save({ ...saved, phase: "opening" });
+    const opened = await client.openProject(saved.cwd);
+    if (!opened.workspace || opened.error) {
+      await save({ ...saved, phase: "directory" });
+      throw new ChatPresetError(
+        "directory",
+        opened.error ?? "The default workspace could not be opened.",
+      );
+    }
+    workspace = opened.workspace;
+  }
+  await save({ ...saved, phase: "ready", workspaceId: workspace.id });
+  const snapshot = await client.getProvidersSnapshot({ cwd: saved.cwd });
+  const setup = resolveChatSetup(snapshot.entries, saved.cwd);
+  return { workspace, setup };
+}
