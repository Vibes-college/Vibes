+import React, { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { JSDOM } from "jsdom";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { EmbeddedReady } from "./ready";
+import { parseAssistantEvent } from "./contract";
+
+const observed = vi.hoisted(() => ({ loaded: false, hosts: [] as { serverId: string }[] }));
+vi.mock("expo-router", () => ({ usePathname: () => "/" }));
+vi.mock("@/runtime/host-runtime", () => ({
+  useHostRegistryLoaded: () => observed.loaded,
+  useHosts: () => observed.hosts,
+}));
+let root: Root;
+let dom: JSDOM;
+const onEvent = vi.fn();
+beforeEach(() => {
+  dom = new JSDOM("<!doctype html><div id='root'></div>");
+  vi.stubGlobal("window", dom.window);
+  vi.stubGlobal("document", dom.window.document);
+  vi.stubGlobal("React", React);
+  vi.stubGlobal("IS_REACT_ACT_ENVIRONMENT", true);
+  vi.stubGlobal("__vibesPaseoEnvironment", { onEvent });
+  observed.loaded = false;
+  observed.hosts = [];
+  onEvent.mockClear();
+  root = createRoot(document.getElementById("root")!);
+});
+afterEach(() => {
+  act(() => root.unmount());
+  dom.window.close();
+  vi.unstubAllGlobals();
+});
+it("reports only hydrated saved-host existence, without host metadata or online claims", () => {
+  observed.hosts = [{ serverId: "private-host-id" }];
+  act(() => root.render(<EmbeddedReady />));
+  expect(onEvent).not.toHaveBeenCalled();
+  observed.loaded = true;
+  act(() => root.render(<EmbeddedReady />));
+  expect(onEvent.mock.calls).toEqual([[{ version: 1, type: "saved-hosts" }]]);
+  act(() => root.render(<EmbeddedReady />));
+  expect(onEvent).toHaveBeenCalledTimes(1);
+  expect(parseAssistantEvent({ version: 1, type: "saved-hosts" })).toEqual({
+    version: 1,
+    type: "saved-hosts",
+  });
+  expect(parseAssistantEvent({ version: 1, type: "saved-hosts", serverId: "private" })).toBeNull();
+});
+it("does not bypass onboarding for an empty saved registry", () => {
+  observed.loaded = true;
+  act(() => root.render(<EmbeddedReady />));
+  expect(onEvent).not.toHaveBeenCalled();
+});
