+import { useEffect, useRef, useState, type ComponentType } from 'react';
+import { Pressable, Text, View } from 'react-native';
+import { StyleSheet } from 'react-native-unistyles';
+import { useTranslation } from 'react-i18next';
+import { HighlightedCodeBlock } from '@/components/highlighted-code-block';
+import type { MarkdownFenceRendererProps } from '../types';
 
+type Renderer = ComponentType<MarkdownFenceRendererProps>;
+let rendererRequest: Promise<Renderer> | undefined;
+
+function loadRenderer(): Promise<Renderer> {
+  rendererRequest ??= import('./host')
+    .then((module) => module.MermaidFenceHost)
+    .catch((error: unknown) => {
+      rendererRequest = undefined;
+      throw error;
+    });
+  return rendererRequest;
+}
+
+/** Source stays readable until the user explicitly requests the diagram runtime. */
 export function MermaidFence(props: MarkdownFenceRendererProps) {
-  return <MermaidFenceHost {...props} />;
+  const { t } = useTranslation();
+  const [Renderer, setRenderer] = useState<Renderer | null>(null);
+  const [status, setStatus] = useState<'idle' | 'loading' | 'error'>('idle');
+  const mounted = useRef(true);
+  useEffect(() => {
+    mounted.current = true;
+    return () => {
+      mounted.current = false;
+    };
+  }, []);
+  const expand = () => {
+    if (status === 'loading') return;
+    setStatus('loading');
+    void loadRenderer().then(
+      (component) => {
+        if (mounted.current) setRenderer(() => component);
+      },
+      () => {
+        if (mounted.current) setStatus('error');
+      }
+    );
+  };
+  // Keep the original renderer, sandbox, render policy and source/diagram controls.
+  if (Renderer) return <Renderer {...props} />;
+  return (
+    <View testID="paseo-mermaid-lazy-fence">
+      <HighlightedCodeBlock
+        code={props.code}
+        language="mermaid"
+        inheritedStyles={props.inheritedStyles}
+        textStyle={props.textStyle}
+      />
+      {status === 'error' ? (
+        <Text
+          style={styles.status}
+          accessibilityLiveRegion="polite"
+          testID="paseo-mermaid-load-error"
+        >
+          {t('common.states.downloadFailed')}
+        </Text>
+      ) : null}
+      <Pressable
+        accessibilityRole="button"
+        disabled={status === 'loading'}
+        onPress={expand}
+        style={styles.button}
+        testID="paseo-mermaid-expand"
+      >
+        <Text style={styles.status}>
+          {status === 'loading'
+            ? t('common.loading')
+            : status === 'error'
+            ? t('common.actions.retry')
+            : t('message.diagram.viewDiagram')}
+        </Text>
+      </Pressable>
+    </View>
+  );
 }
+
+const styles = StyleSheet.create((theme) => ({
+  button: {
+    alignSelf: 'flex-start',
+    minHeight: 32,
+    paddingHorizontal: 12,
+    paddingVertical: 8,
+    borderRadius: 8,
+    backgroundColor: theme.colors.surface2,
+  },
+  status: { color: theme.colors.foregroundMuted, fontSize: 12, lineHeight: 18 },
+}));
