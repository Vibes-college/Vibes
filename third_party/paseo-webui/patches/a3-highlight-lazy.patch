diff --git a/packages/app/src/hooks/use-highlight-runtime.ts b/packages/app/src/hooks/use-highlight-runtime.ts
new file mode 100644
index 0000000..02346f6
--- /dev/null
+++ b/packages/app/src/hooks/use-highlight-runtime.ts
@@ -0,0 +1,55 @@
+import { useCallback, useEffect, useState } from "react";
+import { useRetainedPanelActive } from "@/components/retained-panel";
+import { useAppActivelyVisible } from "@/hooks/use-app-visible";
+
+type Runtime = typeof import("@/utils/highlight-runtime");
+let loaded: Runtime | null = null;
+let pending: Promise<Runtime> | undefined;
+function load() {
+  pending ??= import("@/utils/highlight-runtime").then(
+    (runtime) => (loaded = runtime),
+    (error: unknown) => {
+      pending = undefined;
+      throw error;
+    },
+  );
+  return pending;
+}
+
+// Raw content stays synchronous. Grammars are requested only for a visible,
+// stable value; the original cache and size guards still own tokenization.
+export function useHighlightRuntime(key: unknown, enabled: boolean) {
+  const active = useRetainedPanelActive();
+  const visible = useAppActivelyVisible();
+  const [ready, setReady] = useState<{ key: unknown; runtime: Runtime } | null>(null);
+  const [failed, setFailed] = useState(false);
+  const [attempt, setAttempt] = useState(0);
+  const retry = useCallback(() => {
+    setFailed(false);
+    setAttempt((n) => n + 1);
+  }, []);
+  useEffect(() => {
+    if (!enabled || !active || !visible || failed) return;
+    let current = true;
+    const timer = setTimeout(() => {
+      const promise = loaded ? Promise.resolve(loaded) : load();
+      void promise.then(
+        (runtime) => {
+          if (current) setReady({ key, runtime });
+        },
+        () => {
+          if (current) setFailed(true);
+        },
+      );
+    }, 160);
+    return () => {
+      current = false;
+      clearTimeout(timer);
+    };
+  }, [key, enabled, active, visible, failed, attempt]);
+  return {
+    runtime: enabled && active && visible && ready && ready.key === key ? ready.runtime : null,
+    failed,
+    retry,
+  };
+}
