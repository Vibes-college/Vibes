+++ b/packages/app/src/i18n/provider.test.tsx
@@ -0,0 +1,95 @@
+import React, { act, useEffect } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { JSDOM } from "jsdom";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { I18nProvider } from "./provider";
+const state = vi.hoisted(() => ({ locale: "en", change: vi.fn(), load: vi.fn() }));
+vi.mock("@/hooks/use-settings", () => ({
+  useAppSettings: () => ({ settings: { language: state.locale } }),
+}));
+vi.mock("@/embedded/environment", () => ({ getEmbeddedHost: () => null }));
+vi.mock("expo-localization", () => ({ getLocales: () => [{ languageTag: "en" }] }));
+vi.mock("@/constants/platform", () => ({ isWeb: true }));
+vi.mock("./i18next", () => ({ i18n: { changeLanguage: state.change } }));
+vi.mock("./load-locale", () => ({ loadLocale: state.load }));
+vi.mock("react-i18next", () => ({
+  I18nextProvider: ({ children }: { children: React.ReactNode }) => children,
+}));
+vi.mock("./language-load-notice", () => ({
+  LanguageLoadNotice: ({ retry }: { retry: () => void }) => (
+    <button onClick={retry}>Retry language</button>
+  ),
+}));
+let root: Root;
+let dom: JSDOM;
+let mounts: number;
+function Child() {
+  useEffect(() => {
+    mounts++;
+  }, []);
+  return <input defaultValue="keep draft" />;
+}
+function render() {
+  root.render(
+    <I18nProvider>
+      <Child />
+    </I18nProvider>,
+  );
+}
+function deferred() {
+  let resolve!: () => void;
+  let reject!: (error: Error) => void;
+  const promise = new Promise<void>((yes, no) => {
+    resolve = yes;
+    reject = no;
+  });
+  return { promise, resolve, reject };
+}
+beforeEach(() => {
+  dom = new JSDOM("<!doctype html><div id='root'></div>");
+  for (const [key, value] of Object.entries({
+    React,
+    IS_REACT_ACT_ENVIRONMENT: true,
+    window: dom.window,
+    document: dom.window.document,
+    navigator: dom.window.navigator,
+  })) {
+    vi.stubGlobal(key, value);
+  }
+  state.locale = "en";
+  state.change.mockReset().mockResolvedValue(undefined);
+  state.load.mockReset().mockResolvedValue(undefined);
+  mounts = 0;
+  root = createRoot(document.getElementById("root")!);
+});
+afterEach(() => {
+  act(() => root.unmount());
+  dom.window.close();
+  vi.unstubAllGlobals();
+});
+it("does not apply a late language selection or remount the application", async () => {
+  const first = deferred();
+  state.locale = "fr";
+  state.load.mockReturnValueOnce(first.promise);
+  await act(async () => render());
+  const input = document.querySelector("input");
+  state.locale = "ja";
+  await act(async () => render());
+  await act(async () => first.resolve());
+  expect(state.change.mock.calls).toEqual([["ja"]]);
+  expect(document.querySelector("input")).toBe(input);
+  expect(mounts).toBe(1);
+});
+it("keeps the application on failure and retries only after an explicit action", async () => {
+  state.locale = "fr";
+  state.load.mockRejectedValueOnce(new Error("offline"));
+  await act(async () => render());
+  expect(document.body.textContent).toContain("Retry language");
+  expect(state.change).not.toHaveBeenCalled();
+  await act(async () => render());
+  expect(state.load).toHaveBeenCalledTimes(1);
+  await act(async () => document.querySelector("button")!.click());
+  expect(state.change).toHaveBeenCalledWith("fr");
+  expect(document.querySelector("button")).toBeNull();
+  expect(mounts).toBe(1);
+});
