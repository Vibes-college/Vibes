@@ -0,0 +1,51 @@
+import { createInstance } from "i18next";
+import { describe, expect, it, vi } from "vitest";
+import { createLocaleLoader } from "./load-locale";
+import { en } from "./resources/en";
+
+it("shares one pending request and clears failed downloads for explicit retry", async () => {
+  const instance = createInstance();
+  await instance.init({ lng: "en", fallbackLng: "en", resources: { en: { translation: en } } });
+  let reject!: (error: Error) => void;
+  const pending = new Promise<typeof en>((_resolve, no) => {
+    reject = no;
+  });
+  const source = vi.fn().mockReturnValueOnce(pending).mockResolvedValue(en);
+  const load = createLocaleLoader(instance, {
+    ar: source,
+    es: source,
+    fr: source,
+    ja: source,
+    ko: source,
+    "pt-BR": source,
+    ru: source,
+    "zh-CN": source,
+  });
+  const first = load("fr");
+  expect(load("fr")).toBe(first);
+  reject(new Error("offline"));
+  await expect(first).rejects.toThrow("offline");
+  expect(instance.language).toBe("en");
+  await load("fr");
+  await load("fr");
+  await load("en");
+  expect(source).toHaveBeenCalledTimes(2);
+  expect(instance.hasResourceBundle("fr", "translation")).toBe(true);
+  expect(instance.language).toBe("en");
+});
+
+describe("fallback content", () => {
+  it("keeps English available for missing keys in a loaded language", async () => {
+    const instance = createInstance();
+    await instance.init({
+      lng: "fr",
+      fallbackLng: "en",
+      resources: {
+        en: { translation: en },
+        fr: { translation: { common: { back: "Retour" } } },
+      },
+    });
+    expect(instance.t("common.back")).toBe("Retour");
+    expect(instance.t("common.actions.retry")).toBe("Retry");
+  });
+});
diff --git a/packages/app/src/i18n/load-locale.ts b/packages/app/src/i18n/load-locale.ts
new file mode 100644
index 0000000..2eba64e
--- /dev/null
+++ b/packages/app/src/i18n/load-locale.ts
@@ -0,0 +1,40 @@
+import type { SupportedLocale } from "./locales";
+import type { TranslationResources } from "./resources/en";
+import { i18n } from "./i18next";
+
+type Loaders = Record<Exclude<SupportedLocale, "en">, () => Promise<TranslationResources>>;
+const loaders: Loaders = {
+  ar: () => import("./resources/ar").then((module) => module.ar),
+  es: () => import("./resources/es").then((module) => module.es),
+  fr: () => import("./resources/fr").then((module) => module.fr),
+  ja: () => import("./resources/ja").then((module) => module.ja),
+  ko: () => import("./resources/ko").then((module) => module.ko),
+  "pt-BR": () => import("./resources/pt-BR").then((module) => module.ptBR),
+  ru: () => import("./resources/ru").then((module) => module.ru),
+  "zh-CN": () => import("./resources/zh-CN").then((module) => module.zhCN),
+};
+
+export function createLocaleLoader(
+  controller: Pick<typeof i18n, "hasResourceBundle" | "addResourceBundle">,
+  sources: Loaders,
+) {
+  const pending = new Map<SupportedLocale, Promise<void>>();
+  return function load(locale: SupportedLocale): Promise<void> {
+    if (locale === "en" || controller.hasResourceBundle(locale, "translation")) {
+      return Promise.resolve();
+    }
+    const existing = pending.get(locale);
+    if (existing) return existing;
+    const request = sources[locale]().then((resources) => {
+      controller.addResourceBundle(locale, "translation", resources, true, true);
+    });
+    pending.set(locale, request);
+    // Keep one request per language; a rejection must not poison the retry cache.
+    void request.then(
+      () => pending.delete(locale),
+      () => pending.delete(locale),
+    );
+    return request;
+  };
+}
+export const loadLocale = createLocaleLoader(i18n, loaders);
diff --git a/packages/app/src/i18n/provider.test.tsx b/packages/app/src/i18n/provider.test.tsx
