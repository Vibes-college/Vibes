+import { Pressable, Text, View } from "react-native";
+import { useTranslation } from "react-i18next";
+import { StyleSheet } from "react-native-unistyles";
+
+export function LanguageLoadNotice({ retry }: { retry: () => void }) {
+  const { t } = useTranslation();
+  return (
+    <View style={styles.notice} testID="paseo-language-error">
+      <Text accessibilityLiveRegion="polite" style={styles.text}>
+        {t("settings.general.language.label")}: {t("common.states.downloadFailed")}
+      </Text>
+      <Pressable accessibilityRole="button" onPress={retry} testID="paseo-language-retry">
+        <Text style={styles.text}>{t("common.actions.retry")}</Text>
+      </Pressable>
+    </View>
+  );
+}
+const styles = StyleSheet.create((theme) => ({
+  notice: {
+    position: "absolute",
+    bottom: 16,
+    left: 16,
+    right: 16,
+    zIndex: 10000,
+    backgroundColor: theme.colors.background,
+    borderColor: theme.colors.border,
+    borderWidth: 1,
+    borderRadius: 8,
+    gap: 8,
+    padding: 12,
+  },
+  text: { color: theme.colors.foreground },
+}));
diff --git a/packages/app/src/i18n/load-locale.test.ts b/packages/app/src/i18n/load-locale.test.ts
