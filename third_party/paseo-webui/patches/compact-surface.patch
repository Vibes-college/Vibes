+import React, { act, useCallback, useState } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { JSDOM } from "jsdom";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import type { WorkspaceTab } from "@/workspace-tabs/model";
+import { useCompactConversation } from "./use-compact-conversation";
+
+let dom: JSDOM;
+let root: Root;
+let surface: "compact" | "full";
+let listeners: Set<() => void>;
+let latest: { tabs: WorkspaceTab[]; activeTabId: string | null };
+let activate: (tabId: string) => void;
+let setNativeTabs: (tabs: WorkspaceTab[], activeTabId: string) => void;
+let onEvent: ReturnType<typeof vi.fn>;
+let created: number;
+const original: WorkspaceTab[] = [
+  { tabId: "agent", target: { kind: "agent", agentId: "a" }, createdAt: 1 },
+  { tabId: "draft", target: { kind: "draft", draftId: "d" }, createdAt: 2 },
+  {
+    tabId: "file",
+    target: { kind: "file", path: "x.ts" },
+    createdAt: 3,
+    state: { edit: "keep unsaved" },
+  },
+  { tabId: "terminal", target: { kind: "terminal", terminalId: "running" }, createdAt: 4 },
+];
+function Harness({
+  hydrated = true,
+  active = true,
+  initial = original,
+  focused = "agent",
+  workspaceKey = "host:workspace",
+}: {
+  hydrated?: boolean;
+  active?: boolean;
+  initial?: WorkspaceTab[];
+  focused?: string;
+  workspaceKey?: string;
+}) {
+  const [state, setState] = useState({ tabs: initial, activeTabId: focused as string | null });
+  const focusTab = useCallback(
+    (tabId: string) => setState((value) => ({ ...value, activeTabId: tabId })),
+    [],
+  );
+  const createDraft = useCallback(() => {
+    const tab: WorkspaceTab = {
+      tabId: `created-${++created}`,
+      createdAt: 10,
+      target: { kind: "draft", draftId: "native-new" },
+    };
+    setState((value) => ({ tabs: [...value.tabs, tab], activeTabId: tab.tabId }));
+  }, []);
+  activate = focusTab;
+  setNativeTabs = (tabs, activeTabId) => setState({ tabs, activeTabId });
+  latest = state;
+  useCompactConversation({
+    workspaceKey,
+    active,
+    hydrated,
+    ...state,
+    focusTab,
+    createDraft,
+  });
+  return null;
+}
