+    serverId: string;
+    workspaceId: string;
+  } | null,
+  dispatch: vi.fn(() => true),
+  toggleMenu: vi.fn(),
+  showMobileAgent: vi.fn(),
+  navigate: vi.fn(),
+}));
+vi.mock("expo-router", () => ({ usePathname: () => state.pathname }));
+vi.mock("react-i18next", () => ({
+  useTranslation: () => ({ t: (key: string) => key, i18n: { language: "zh" } }),
+}));
+vi.mock("react-native-unistyles", () => ({
+  useUnistyles: () => ({ rt: { breakpoint: state.breakpoint } }),
+}));
+vi.mock("@/keyboard/keyboard-action-dispatcher-context", () => ({
+  useKeyboardActionDispatcher: () => ({ dispatch: state.dispatch }),
+}));
+vi.mock("@/stores/navigation-active-workspace-store", () => ({
+  useLastWorkspaceSelection: () => state.selection,
+}));
+vi.mock("@/navigation/workspace-route-navigation", () => ({
+  navigateToHostWorkspaceRoute: state.navigate,
+}));
+vi.mock("@/stores/panel-store", () => ({
+  selectIsAgentListOpen: () => state.menuOpen,
+  usePanelStore: (select: (store: unknown) => unknown) =>
+    select({ toggleAgentListForLayout: state.toggleMenu, showMobileAgent: state.showMobileAgent }),
+}));
+
+let dom: JSDOM;
+let root: Root;
+let host: {
+  surface: "compact" | "full";
+  root: HTMLElement;
+  toolbarRoot: HTMLElement;
+  subscribe(listener: () => void): () => void;
+  onEvent: ReturnType<typeof vi.fn>;
+};
+let listeners: Set<() => void>;
+function setSurface(surface: "compact" | "full") {
+  act(() => {
+    host.surface = surface;
+    listeners.forEach((listener) => listener());
+  });
+}
+beforeEach(() => {
+  dom = new JSDOM("<!doctype html><div id='toolbar'></div><div id='root'></div>", {
+    url: "https://vibes.college",
+  });
+  for (const [key, value] of Object.entries({
+    React,
+    IS_REACT_ACT_ENVIRONMENT: true,
+    window: dom.window,
+    document: dom.window.document,
+  }))
+    vi.stubGlobal(key, value);
+  listeners = new Set();
+  host = {
+    surface: "compact",
+    root: document.getElementById("root")!,
+    toolbarRoot: document.getElementById("toolbar")!,
+    subscribe(listener) {
+      listeners.add(listener);
+      return () => {
+        listeners.delete(listener);
+      };
+    },
+    onEvent: vi.fn(),
+  };
+  vi.stubGlobal("__vibesPaseoEnvironment", host);
+  state.pathname = "/h/host/workspace/work";
+  state.selection = { serverId: "host", workspaceId: "work" };
+  state.breakpoint = "xs";
+  state.menuOpen = false;
+  vi.clearAllMocks();
+  root = createRoot(host.root);
+});
+afterEach(() => {
+  act(() => root.unmount());
+  dom.window.close();
+  vi.unstubAllGlobals();
+});
+it("portals only the compact new-conversation action into the explicit host slot", () => {
+  act(() => root.render(<EmbeddedToolbar />));
+  expect(host.root.querySelector("button")).toBeNull();
+  expect(host.toolbarRoot.querySelectorAll("button")).toHaveLength(1);
+  const button = host.toolbarRoot.querySelector<HTMLButtonElement>("button")!;
+  expect(button.dataset.testid).toBe("embedded-new-conversation");
+  expect(button.style.height).toBe("44px");
+  act(() => button.click());
+  expect(state.dispatch).toHaveBeenCalledWith({ id: "workspace.agent.new", scope: "workspace" });
+  expect(state.toggleMenu).not.toHaveBeenCalled();
+});
+it("replaces the action with only the native menu toggle in full mode", () => {
+  act(() => root.render(<EmbeddedToolbar />));
+  setSurface("full");
+  const buttons = host.toolbarRoot.querySelectorAll<HTMLButtonElement>("button");
+  expect(buttons).toHaveLength(1);
+  expect(buttons[0].dataset.testid).toBe("menu-button");
+  act(() => buttons[0].click());
+  expect(state.toggleMenu).toHaveBeenCalledWith({ isCompact: true });
+  expect(state.dispatch).not.toHaveBeenCalled();
+});
+it("returns from full settings to the native last workspace when compact is selected", () => {
+  host.surface = "full";
+  state.pathname = "/settings";
+  act(() => root.render(<EmbeddedToolbar />));
+  expect(state.navigate).not.toHaveBeenCalled();
+  setSurface("compact");
+  expect(state.navigate).toHaveBeenCalledTimes(1);
+  expect(state.navigate.mock.calls[0][0]).toContain("work");
+});
+it("does not expose an actionable new-conversation button before the workspace exists", () => {
+  state.pathname = "/vibes-chat";
+  state.selection = null;
+  act(() => root.render(<EmbeddedToolbar />));
+  const button = host.toolbarRoot.querySelector<HTMLButtonElement>("button")!;
+  expect(button.disabled).toBe(true);
+  act(() => button.click());
+  expect(state.dispatch).not.toHaveBeenCalled();
+});
+it("moves Files left with the full native mobile layout and retains the desktop explorer", () => {
+  function Probe() {
+    return <span>{String(useEmbeddedMobileFiles())}</span>;
+  }
+  Object.defineProperty(window, "innerWidth", { configurable: true, value: 1200 });
+  act(() => root.render(<Probe />));
+  expect(host.root.textContent).toBe("false");
+  state.breakpoint = "lg";
+  setSurface("full");
+  expect(host.root.textContent).toBe("false");
+  act(() => {
+    Object.defineProperty(window, "innerWidth", { configurable: true, value: 390 });
+    state.breakpoint = "xs";
+    root.render(<Probe />);
+  });
+  expect(host.root.textContent).toBe("true");
+  setSurface("compact");
+  expect(host.root.textContent).toBe("false");
+});
+it.each([
+  [531, "xs"],
+  [719, "sm"],
+] as const)("keeps Files with the native drawer at %dpx (%s)", (width, breakpoint) => {
+  function Probe() {
+    return <span>{String(useEmbeddedMobileFiles())}</span>;
+  }
+  host.surface = "full";
+  state.breakpoint = breakpoint;
+  Object.defineProperty(window, "innerWidth", { configurable: true, value: width });
+  act(() => root.render(<Probe />));
+  expect(host.root.textContent).toBe("true");
+  setSurface("compact");
