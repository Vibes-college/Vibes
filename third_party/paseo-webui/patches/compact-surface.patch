+  (tabId) => {
+    surface = "compact";
+    act(() => root.render(<Harness />));
+    act(() => activate("draft"));
+    act(() => activate(tabId));
+    expect(onEvent).toHaveBeenCalledExactlyOnceWith({
+      version: 1,
+      type: "surface",
+      value: "full",
+    });
+    expect(latest.activeTabId).toBe(tabId);
+    expect(latest.tabs).toBe(original);
+    expect(latest.tabs[2].state).toEqual({ edit: "keep unsaved" });
+    expect(created).toBe(0);
+
+    // Native state can publish again before the host applies the requested surface.
+    act(() => setNativeTabs([...original], tabId));
+    expect(onEvent).toHaveBeenCalledTimes(1);
+    expect(latest.activeTabId).toBe(tabId);
+    changeSurface("full");
+    expect(latest.activeTabId).toBe(tabId);
+    changeSurface("compact");
+    expect(latest.activeTabId).toBe("draft");
+    expect(onEvent).toHaveBeenCalledTimes(1);
+  },
+);
+it("waits for native hydration and creates exactly one native draft if there is no conversation", () => {
+  surface = "compact";
+  act(() => root.render(<Harness hydrated={false} initial={original.slice(2)} focused="file" />));
+  expect(created).toBe(0);
+  act(() => root.render(<Harness hydrated initial={original.slice(2)} focused="file" />));
+  expect(created).toBe(1);
+  expect(latest.activeTabId).toBe("created-1");
+  expect(latest.tabs.slice(0, 2)).toEqual(original.slice(2));
+  changeSurface("full");
+  changeSurface("compact");
+  expect(created).toBe(1);
+  expect(onEvent).not.toHaveBeenCalled();
+});
+it("does not redirect or create in an inactive retained workspace", () => {
+  surface = "compact";
+  act(() => root.render(<Harness active={false} initial={original.slice(2)} focused="file" />));
+  expect(created).toBe(0);
+  expect(latest.activeTabId).toBe("file");
+  expect(onEvent).not.toHaveBeenCalled();
+});
+it("restores the last conversation when a retained workspace becomes active in compact", () => {
+  surface = "compact";
+  act(() => root.render(<Harness />));
+  act(() => activate("draft"));
+  act(() => root.render(<Harness active={false} />));
+  act(() => activate("file"));
+  expect(latest.activeTabId).toBe("file");
+  expect(onEvent).not.toHaveBeenCalled();
+  act(() => root.render(<Harness active />));
+  expect(latest.activeTabId).toBe("draft");
+  expect(latest.tabs).toBe(original);
+  expect(onEvent).not.toHaveBeenCalled();
+});
+it("restores a different workspace without reusing the prior workspace's conversation", () => {
+  surface = "compact";
+  act(() => root.render(<Harness focused="agent" />));
+  const otherTabs = original.map((tab) => ({ ...tab, tabId: `other-${tab.tabId}` }));
+  act(() => {
+    setNativeTabs(otherTabs, "other-file");
+    root.render(<Harness workspaceKey="host:other" />);
