+
+describe("dictation confirmation and replay", () => {
+  it.each(["resolve", "reject"] as const)(
+    "restarts immediately after cancel without letting an old start ACK %s affect new recording",
+    async (settlement) => {
+      const oldAck = deferred<void>();
+      const newAck = deferred<void>();
+      mock.restartStream.mockReturnValueOnce(oldAck.promise).mockReturnValueOnce(newAck.promise);
+      let first!: Promise<void>;
+      await act(async () => {
+        first = latest.startDictation();
+      });
+      expect(latest.isRecording).toBe(true);
+      await act(async () => {
+        await latest.cancelDictation();
+      });
+      expect(latest.status).toBe("idle");
+      let second!: Promise<void>;
+      await act(async () => {
+        second = latest.startDictation();
+      });
+      expect(mock.audioStart).toHaveBeenCalledTimes(2);
+      expect(mock.restartStream).toHaveBeenCalledTimes(2);
+      expect(latest.isRecording).toBe(true);
+      const stopCount = mock.audioStop.mock.calls.length;
+      await act(async () => {
+        if (settlement === "resolve") oldAck.resolve();
+        else oldAck.reject(new Error("old stream timed out"));
+        await first;
+        await latest.startDictation();
+      });
+      expect(mock.audioStart).toHaveBeenCalledTimes(2);
+      expect(mock.audioStop).toHaveBeenCalledTimes(stopCount);
+      expect(latest.isRecording).toBe(true);
+      expect(options.onError).not.toHaveBeenCalled();
+      await act(async () => {
+        newAck.resolve();
+        await second;
+        await latest.confirmDictation();
+      });
