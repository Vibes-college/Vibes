+import React, { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { JSDOM } from "jsdom";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import type { ProviderSnapshotEntry } from "@getpaseo/protocol/agent-types";
+import type { FormPreferences } from "@/create-agent-preferences/preferences";
+import {
+  useAgentFormState,
+  type FormInitialValues,
+  type UseAgentFormStateResult,
+} from "@/hooks/use-agent-form-state";
+
+const mock = vi.hoisted(() => ({
+  preferences: {} as FormPreferences,
+  preferencesLoading: false,
+  entries: [] as ProviderSnapshotEntry[],
+  loading: false,
+  hosts: [{ serverId: "host" }],
+  updatePreferences: vi.fn(),
+  refresh: vi.fn(),
+  refetchIfStale: vi.fn(),
+}));
+vi.mock("@/runtime/host-runtime", () => ({ useHosts: () => mock.hosts }));
+vi.mock("@/hooks/use-providers-snapshot", () => ({
+  useProvidersSnapshot: () => ({
+    entries: mock.entries,
+    isLoading: mock.loading,
+    isRefreshing: false,
+    error: null,
+    refresh: mock.refresh,
+    refetchIfStale: mock.refetchIfStale,
+  }),
+}));
+vi.mock("@/hooks/use-form-preferences", async () => {
+  const { mergeProviderPreferences } = await import("@/create-agent-preferences/preferences");
+  return {
+    mergeProviderPreferences,
+    useFormPreferences: () => ({
+      preferences: mock.preferences,
+      isLoading: mock.preferencesLoading,
+      updatePreferences: mock.updatePreferences,
+    }),
+  };
+});
+
+const ready: ProviderSnapshotEntry[] = [
+  {
+    provider: "codex",
+    enabled: true,
+    status: "ready",
+    defaultModeId: "auto",
+    modes: [{ id: "auto", label: "Auto" }],
+    models: [
+      {
+        provider: "codex",
+        id: "current-luna-id",
+        aliases: ["gpt-5.6-luna"],
+        label: "Luna",
+        thinkingOptions: [
+          { id: "medium", label: "Medium" },
+          { id: "high", label: "High" },
+        ],
+        defaultThinkingOptionId: "medium",
+      },
+      { provider: "codex", id: "other-model", label: "Other" },
+    ],
+  },
+  {
+    provider: "claude",
+    enabled: true,
+    status: "ready",
+    models: [{ provider: "claude", id: "claude-choice", label: "Claude choice" }],
+  },
+];
+let dom: JSDOM;
+let root: Root;
+let latest: UseAgentFormStateResult;
+function Probe({ initialValues }: { initialValues?: FormInitialValues }) {
+  latest = useAgentFormState({
+    initialServerId: "host",
+    initialValues: { workingDir: "/home/test/Vibes", ...initialValues },
+    onlineServerIds: ["host"],
+  });
+  return null;
+}
+function render(initialValues?: FormInitialValues, key = "draft") {
+  act(() => root.render(<Probe key={key} initialValues={initialValues} />));
+}
+beforeEach(() => {
+  vi.clearAllMocks();
+  dom = new JSDOM("<div id='root'></div>");
+  vi.stubGlobal("window", dom.window);
+  vi.stubGlobal("document", dom.window.document);
+  vi.stubGlobal("React", React);
+  vi.stubGlobal("IS_REACT_ACT_ENVIRONMENT", true);
+  vi.stubGlobal("__vibesPaseoEnvironment", {});
+  mock.preferences = {};
+  mock.preferencesLoading = false;
+  mock.entries = ready;
+  mock.loading = false;
+  mock.updatePreferences.mockImplementation(async (update) => {
+    mock.preferences =
+      typeof update === "function" ? update(mock.preferences) : { ...mock.preferences, ...update };
+    return mock.preferences;
+  });
+  root = createRoot(document.getElementById("root")!);
+});
+afterEach(() => {
+  act(() => root.unmount());
+  dom.window.close();
+  vi.unstubAllGlobals();
+});
+
+it("defaults every fresh embedded native draft to the actual Luna model without writing preferences", () => {
+  render();
+  expect(latest).toMatchObject({
+    selectedProvider: "codex",
+    selectedModel: "current-luna-id",
+    selectedThinkingOptionId: "medium",
+    workingDir: "/home/test/Vibes",
+    isModelLoading: false,
+  });
+  render(undefined, "second-native-draft");
+  expect(latest.selectedModel).toBe("current-luna-id");
+  expect(mock.preferences).toEqual({});
+  expect(mock.updatePreferences).not.toHaveBeenCalled();
+});
+
+it("waits for native preference hydration and the Codex loading snapshot before resolving", () => {
+  mock.preferencesLoading = true;
+  render();
+  expect(latest.selectedProvider).toBeNull();
+  mock.preferencesLoading = false;
+  mock.entries = [{ ...ready[0], status: "loading", models: [] }, ready[1]];
+  mock.loading = true;
+  render();
+  expect(latest.isModelLoading).toBe(true);
+  expect(latest.selectedProvider).toBeNull();
+  mock.entries = ready;
+  mock.loading = false;
+  render();
+  expect(latest.selectedModel).toBe("current-luna-id");
+  expect(latest.isModelLoading).toBe(false);
+  expect(mock.updatePreferences).not.toHaveBeenCalled();
+});
+
+it("keeps a saved native model preference ahead of the embedded default", () => {
+  mock.preferences = {
+    provider: "codex",
+    providerPreferences: { codex: { model: "other-model" } },
+  };
+  render();
+  expect(latest.selectedModel).toBe("other-model");
+  expect(mock.updatePreferences).not.toHaveBeenCalled();
+});
+
+it("keeps an explicit initial selection and a different saved provider", () => {
+  mock.preferences = {
+    provider: "claude",
+    providerPreferences: { claude: { model: "claude-choice" } },
+  };
+  render();
+  expect(latest).toMatchObject({ selectedProvider: "claude", selectedModel: "claude-choice" });
+  render({ provider: "codex", model: "other-model" }, "explicit-draft");
+  expect(latest).toMatchObject({ selectedProvider: "codex", selectedModel: "other-model" });
+  expect(mock.updatePreferences).not.toHaveBeenCalled();
+});
+
+it("does not refill an explicit clear while the initial provider snapshot finishes loading", () => {
+  mock.entries = [{ ...ready[0], status: "loading", models: [] }, ready[1]];
+  mock.loading = true;
+  render();
+  act(() => latest.clearProviderSelectionFromUser());
+  mock.entries = ready;
+  mock.loading = false;
+  render();
+  expect(latest.selectedProvider).toBeNull();
+  expect(latest.selectedModel).toBe("");
+  expect(latest.isModelLoading).toBe(false);
+  expect(mock.updatePreferences).not.toHaveBeenCalled();
+});
+
+it("keeps an applied user profile when Codex later finishes loading", async () => {
+  mock.entries = [{ ...ready[0], status: "loading", models: [] }, ready[1]];
+  mock.loading = true;
+  render();
+  await act(async () => {
+    latest.applyProfileFromUser({
+      provider: "claude",
+      modelId: "claude-choice",
+      modeId: "",
+      thinkingOptionId: "",
+      featureValues: {},
+    });
+  });
+  mock.entries = ready;
+  mock.loading = false;
+  render();
+  expect(latest).toMatchObject({ selectedProvider: "claude", selectedModel: "claude-choice" });
+  expect(mock.updatePreferences).toHaveBeenCalledTimes(1);
+});
+
+it.each(["unavailable", "missing-luna"])(
+  "retains the original selection entry when Codex is %s",
+  (reason) => {
+    mock.entries = [
+      reason === "unavailable"
+        ? { ...ready[0], enabled: false, status: "unavailable" }
+        : { ...ready[0], models: [ready[0].models![1]] },
+      ready[1],
+    ];
+    render();
+    expect(latest.selectedProvider).toBeNull();
+    expect(latest.selectedModel).toBe("");
+    expect(latest.isModelLoading).toBe(false);
+    expect(mock.updatePreferences).not.toHaveBeenCalled();
+  },
+);
+
+it("leaves standalone native draft defaults unchanged", () => {
+  vi.stubGlobal("__vibesPaseoEnvironment", undefined);
+  render();
+  expect(latest.selectedProvider).toBeNull();
+  expect(latest.selectedModel).toBe("");
+  expect(mock.updatePreferences).not.toHaveBeenCalled();
+});
