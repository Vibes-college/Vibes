diff --git a/packages/app/src/appearance/provider.test.tsx b/packages/app/src/appearance/provider.test.tsx
new file mode 100644
index 0000000..587dfce
--- /dev/null
+++ b/packages/app/src/appearance/provider.test.tsx
@@ -0,0 +1,151 @@
+import React, { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { JSDOM } from "jsdom";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { darkTheme, type ThemePreference } from "@/styles/theme";
+import type { PluginThemeOption } from "@/plugins/themes";
+import { AppearanceProvider, useContributedThemes } from "./provider";
+
+const mock = vi.hoisted(() => ({
+  settings: {
+    theme: "dark" as ThemePreference,
+    pluginThemeId: "saved-dark-plugin",
+    uiFontFamily: "",
+    monoFontFamily: "",
+    uiBaseFontSize: 14,
+    contentFontSize: 15,
+    codeFontSize: 12,
+    syntaxTheme: "one",
+  },
+  isLoading: false,
+  options: [] as PluginThemeOption[],
+  updateSettings: vi.fn(),
+  rememberPluginThemeHost: vi.fn(),
+  applyAppearance: vi.fn(),
+  runtime: {
+    setAdaptiveThemes: vi.fn(),
+    setTheme: vi.fn(),
+    updateTheme: vi.fn(),
+  },
+}));
+vi.mock("react-native-unistyles", () => ({ UnistylesRuntime: mock.runtime }));
+vi.mock("@/hooks/use-settings", () => ({
+  DEFAULT_THEME_PREFERENCE: "auto",
+  useAppSettings: () => ({
+    settings: mock.settings,
+    isLoading: mock.isLoading,
+    updateSettings: mock.updateSettings,
+  }),
+}));
+vi.mock("@/plugins/themes", () => ({
+  usePluginThemeCatalog: () => mock.options,
+  rememberPluginThemeHost: mock.rememberPluginThemeHost,
+}));
+vi.mock("./apply", () => ({ applyAppearance: mock.applyAppearance }));
+
+let dom: JSDOM;
+let root: Root;
+let selected: PluginThemeOption | null;
+function SelectedTheme() {
+  selected = useContributedThemes().selected;
+  return null;
+}
+function render() {
+  act(() => {
+    root.render(
+      <AppearanceProvider>
+        <SelectedTheme />
+      </AppearanceProvider>,
+    );
+  });
+}
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  dom = new JSDOM("<div id='root'></div>");
+  vi.stubGlobal("window", dom.window);
+  vi.stubGlobal("document", dom.window.document);
+  vi.stubGlobal("React", React);
+  vi.stubGlobal("IS_REACT_ACT_ENVIRONMENT", true);
+  vi.stubGlobal("__vibesPaseoEnvironment", {});
+  mock.settings.theme = "dark";
+  mock.isLoading = false;
+  mock.options = [
+    {
+      id: "saved-dark-plugin",
+      name: "Saved dark theme",
+      serverId: "host",
+      swatch: "#111111",
+      theme: darkTheme,
+    },
+  ];
+  selected = null;
+  root = createRoot(document.getElementById("root")!);
+});
+afterEach(() => {
+  act(() => root.unmount());
+  expect(mock.updateSettings).not.toHaveBeenCalled();
+  expect(mock.rememberPluginThemeHost).not.toHaveBeenCalled();
+  dom.window.close();
+  vi.unstubAllGlobals();
+});
+
+it.each(["auto", "dark", "pureBlack", "plugin"] as const)(
+  "uses embedded light without overwriting the saved %s preference",
+  (preference) => {
+    mock.settings.theme = preference;
+    render();
+    expect(mock.runtime.setAdaptiveThemes).toHaveBeenCalledExactlyOnceWith(false);
+    expect(mock.runtime.setTheme).toHaveBeenCalledExactlyOnceWith("light");
+    expect(mock.runtime.updateTheme).not.toHaveBeenCalled();
+    expect(mock.settings.theme).toBe(preference);
+    expect(selected).toBeNull();
+    expect(mock.applyAppearance).toHaveBeenCalledWith(
+      expect.objectContaining({ uiBaseFontSize: 14, contentFontSize: 15 }),
+    );
+  },
+);
+
+it("keeps the embedded palette when persisted settings hydrate or later change", () => {
+  mock.isLoading = true;
+  render();
+  expect(mock.runtime.setTheme).not.toHaveBeenCalled();
+  mock.isLoading = false;
+  render();
+  mock.settings.theme = "plugin";
+  render();
+  expect(mock.runtime.setTheme).toHaveBeenCalledExactlyOnceWith("light");
+  expect(mock.runtime.setAdaptiveThemes).toHaveBeenCalledExactlyOnceWith(false);
+  expect(mock.runtime.updateTheme).not.toHaveBeenCalled();
+  expect(mock.settings.theme).toBe("plugin");
+});
+
+it.each([
+  ["dark", "dark"],
+  ["pureBlack", "darkPureBlack"],
+] as const)("preserves standalone %s appearance", (preference, themeName) => {
+  vi.stubGlobal("__vibesPaseoEnvironment", undefined);
+  mock.settings.theme = preference;
+  render();
+  expect(mock.runtime.setAdaptiveThemes).toHaveBeenCalledExactlyOnceWith(false);
+  expect(mock.runtime.setTheme).toHaveBeenCalledExactlyOnceWith(themeName);
+});
+
+it("preserves standalone system appearance", () => {
+  vi.stubGlobal("__vibesPaseoEnvironment", undefined);
+  mock.settings.theme = "auto";
+  render();
+  expect(mock.runtime.setAdaptiveThemes).toHaveBeenCalledExactlyOnceWith(true);
+  expect(mock.runtime.setTheme).not.toHaveBeenCalled();
+});
+
+it("preserves the selected standalone plugin theme", () => {
+  vi.stubGlobal("__vibesPaseoEnvironment", undefined);
+  mock.settings.theme = "plugin";
+  render();
+  expect(mock.runtime.setAdaptiveThemes).toHaveBeenCalledExactlyOnceWith(false);
+  expect(mock.runtime.setTheme).toHaveBeenCalledExactlyOnceWith("pluginDark");
+  expect(mock.runtime.updateTheme).toHaveBeenCalledWith("pluginDark", expect.any(Function));
+  expect(mock.runtime.updateTheme.mock.calls[0][1]()).toBe(darkTheme);
+  expect(selected).toBe(mock.options[0]);
+});
