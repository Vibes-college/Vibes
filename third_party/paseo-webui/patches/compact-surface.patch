+/** The existing tabs row owns this control, so full mode needs no second header. */
+export function EmbeddedDesktopExplorerToggle({ active }: { active: boolean }) {
+  const surface = useEmbeddedSurface();
+  const isMobile = useIsCompactFormFactor();
+  if (surface !== "full" || isMobile || !active) return null;
+  return <ExplorerToggle />;
+}
+
