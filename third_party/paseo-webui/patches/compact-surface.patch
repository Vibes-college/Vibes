@@ -0,0 +1,18 @@
+import { useSyncExternalStore } from "react";
+import { useIsCompactFormFactor } from "@/constants/layout";
+import { getEmbeddedHost } from "./environment";
+
+const subscribe = (listener: () => void) => getEmbeddedHost()?.subscribe(listener) ?? (() => {});
+const getSurface = () => getEmbeddedHost()?.surface ?? null;
+
+/** Host presentation is independent from Paseo's width-based responsive layout. */
+export function useEmbeddedSurface() {
+  return useSyncExternalStore(subscribe, getSurface, () => null);
+}
+
+/** Match the native drawer's responsive layout, only while the host is full. */
+export function useEmbeddedMobileFiles() {
+  const surface = useEmbeddedSurface();
+  const compactLayout = useIsCompactFormFactor();
+  return surface === "full" && compactLayout;
+}
