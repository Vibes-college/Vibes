diff --git a/packages/app/src/styles/unistyles.test.ts b/packages/app/src/styles/unistyles.test.ts
new file mode 100644
index 0000000..de1db93
--- /dev/null
+++ b/packages/app/src/styles/unistyles.test.ts
@@ -0,0 +1,30 @@
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+
+const { configure } = vi.hoisted(() => ({ configure: vi.fn() }));
+vi.mock("react-native-unistyles", () => ({ StyleSheet: { configure } }));
+
+beforeEach(() => {
+  vi.resetModules();
+  configure.mockClear();
+});
+afterEach(() => vi.unstubAllGlobals());
+
+it("initializes the embedded runtime with the complete light palette before settings hydrate", async () => {
+  vi.stubGlobal("__vibesPaseoEnvironment", {});
+  await import("./unistyles");
+  const config = configure.mock.calls[0][0];
+  expect(config.settings).toEqual({ initialTheme: "light" });
+  expect(config.themes.light.colorScheme).toBe("light");
+  expect(config.themes.light.colors).toMatchObject({
+    surface0: "#ffffff",
+    background: "#ffffff",
+    popover: "#ffffff",
+    foreground: "#1a1a1e",
+  });
+});
+
+it("keeps system-adaptive initialization for standalone Paseo", async () => {
+  vi.stubGlobal("__vibesPaseoEnvironment", undefined);
+  await import("./unistyles");
+  expect(configure.mock.calls[0][0].settings).toEqual({ adaptiveThemes: true });
+});
