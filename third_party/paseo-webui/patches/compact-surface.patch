+import React, { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { JSDOM } from "jsdom";
+import { afterEach, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import type { UseDictationOptions, UseDictationResult } from "./use-dictation.shared";
+import type { DictationAudioSourceConfig } from "./use-dictation-audio-source.types";
+
+const mock = vi.hoisted(() => ({
+  finish: vi.fn(),
+  resetStreamForReplay: vi.fn(),
+  audioStart: vi.fn(),
+  audioStop: vi.fn(),
+  restartStream: vi.fn(),
+  cancelStream: vi.fn(),
+  enqueueSegment: vi.fn(),
+  audioConfig: null as DictationAudioSourceConfig | null,
+  nextId: 0,
+}));
+vi.mock("react-i18next", () => ({ useTranslation: () => ({ t: (key: string) => key }) }));
+vi.mock("@/i18n/i18next", () => ({ i18n: { t: (key: string) => key } }));
+vi.mock("@/types/stream", () => ({ generateMessageId: () => String(++mock.nextId) }));
+vi.mock("@/hooks/use-dictation-audio-source", () => ({
+  useDictationAudioSource: (config: DictationAudioSourceConfig) => {
+    mock.audioConfig = config;
+    return { start: mock.audioStart, stop: mock.audioStop, volume: 0 };
+  },
+}));
+vi.mock("@/dictation/dictation-stream-sender", () => ({
+  DictationStreamSender: class {
+    setClient() {}
+    clearAll() {}
+    restartStream = mock.restartStream;
+    getDictationId() {
+      return "dictation";
+    }
+    cancel = mock.cancelStream;
+    enqueueSegment = mock.enqueueSegment;
+    dispose() {}
+    hasSegments() {
+      return true;
+    }
+    getFinalSeq() {
+      return 0;
+    }
+    finish = mock.finish;
+    resetStreamForReplay = mock.resetStreamForReplay;
+  },
+}));
+
+let useDictation: typeof import("./use-dictation").useDictation;
+let root: Root;
+let container: HTMLDivElement;
+let latest: UseDictationResult;
+let options: UseDictationOptions;
+
+beforeAll(async () => {
+  const dom = new JSDOM("<!doctype html><html><body></body></html>");
+  for (const key of ["window", "document", "navigator"] as const) {
+    Object.defineProperty(globalThis, key, { configurable: true, value: dom.window[key] });
+  }
+  Object.defineProperty(globalThis, "IS_REACT_ACT_ENVIRONMENT", {
+    configurable: true,
+    value: true,
+  });
+  ({ useDictation } = await import("./use-dictation"));
+});
+
+beforeEach(() => {
+  mock.finish.mockReset().mockResolvedValue({ text: "hello" });
+  mock.resetStreamForReplay.mockReset();
+  mock.audioStart.mockReset().mockResolvedValue(undefined);
+  mock.audioStop.mockReset().mockResolvedValue(undefined);
+  mock.restartStream.mockReset().mockResolvedValue(undefined);
+  mock.cancelStream.mockReset();
+  mock.enqueueSegment.mockReset();
+  options = {
+    client: {
+      isConnected: true,
+      subscribeConnectionStatus: () => () => undefined,
+      on: () => () => undefined,
+    } as unknown as UseDictationOptions["client"],
+    onTranscript: vi.fn(),
+    onError: vi.fn(),
+  };
+  container = document.createElement("div");
+  document.body.appendChild(container);
+  root = createRoot(container);
+  function Harness() {
+    latest = useDictation(options);
+    return null;
+  }
+  act(() => root.render(<Harness />));
+});
+afterEach(async () => {
+  await act(async () => root.unmount());
+  container.remove();
+  vi.restoreAllMocks();
+});
+
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  let reject!: (error: Error) => void;
+  const promise = new Promise<T>((accept, decline) => {
+    resolve = accept;
+    reject = decline;
+  });
+  return { promise, resolve, reject };
+}
+async function record(): Promise<void> {
+  await act(async () => {
+    await latest.startDictation();
+  });
+  expect(latest.isRecording).toBe(true);
+}
+async function failTranscription(): Promise<void> {
+  vi.spyOn(console, "error").mockImplementation(() => undefined);
+  await record();
+  mock.finish.mockRejectedValueOnce(new Error("disconnected"));
+  await act(async () => {
+    await latest.confirmDictation();
+  });
