+    expect(props.onSubmit).toHaveBeenCalledExactlyOnceWith({
+      text: "Explain this article",
+      attachments: [article],
+      cwd: "/workspace",
+      forceSend: undefined,
+    });
+    expect(props.attachments).toEqual([article]);
+    expect(mock.autofocus).not.toHaveBeenCalled();
