@@ -0,0 +1,68 @@
+import { useLayoutEffect, useRef } from "react";
+import type { WorkspaceTab } from "@/workspace-tabs/model";
+import { isConversationTab, selectCompactConversation } from "./conversation-selection";
+import { getEmbeddedHost } from "./environment";
+import { useEmbeddedSurface } from "./use-embedded-surface";
+
+export function useCompactConversation(input: {
+  workspaceKey: string | null;
+  active: boolean;
+  hydrated: boolean;
+  tabs: readonly WorkspaceTab[];
+  activeTabId: string | null;
+  focusTab(tabId: string): void;
+  createDraft(): void;
+}) {
+  const surface = useEmbeddedSurface();
+  const previous = useRef<{
+    workspaceKey: string | null;
+    active: boolean;
+    hydrated: boolean;
+    surface: typeof surface;
+    activeTabId: string | null;
+    lastConversationTabId: string | null;
+  } | null>(null);
+  useLayoutEffect(() => {
+    const last = previous.current;
+    const sameWorkspace = last?.workspaceKey === input.workspaceKey;
+    const lastConversationTabId = sameWorkspace ? last.lastConversationTabId : null;
+    const ready = input.active && Boolean(input.workspaceKey) && input.hydrated;
+    const activeTab = input.tabs.find((tab) => tab.tabId === input.activeTabId);
+    const activeConversation = isConversationTab(activeTab);
+    const enteringCompact =
+      !sameWorkspace || last?.surface !== "compact" || !last.active || !last.hydrated;
+    previous.current = {
+      workspaceKey: input.workspaceKey,
+      active: input.active,
+      hydrated: input.hydrated,
+      surface,
+      activeTabId: input.activeTabId,
+      lastConversationTabId: ready && activeConversation ? activeTab!.tabId : lastConversationTabId,
+    };
+    if (!ready || activeConversation || surface !== "compact") return;
+    if (enteringCompact) {
+      const next = selectCompactConversation({
+        tabs: input.tabs,
+        activeTabId: input.activeTabId,
+        lastConversationTabId,
+      });
+      if (next) input.focusTab(next);
+      else input.createDraft();
+      return;
+    }
+    // Native file links and tab actions must keep their destination. Only entering
+    // compact restores a conversation; opening another pane expands the host.
+    if (activeTab && activeTab.tabId !== last?.activeTabId) {
+      getEmbeddedHost()?.onEvent({ version: 1, type: "surface", value: "full" });
+    }
+  }, [
+    surface,
+    input.active,
+    input.workspaceKey,
+    input.hydrated,
+    input.tabs,
+    input.activeTabId,
+    input.focusTab,
+    input.createDraft,
+  ]);
+}
