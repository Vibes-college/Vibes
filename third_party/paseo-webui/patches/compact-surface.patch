+import React, { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { JSDOM } from "jsdom";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import HostIndexRoute from "@/app/h/[serverId]/index";
+
+const state = vi.hoisted(() => ({
+  selection: null as { serverId: string; workspaceId: string } | null,
+  hydrated: true,
+  exists: true,
+  href: null as unknown,
+}));
+vi.mock("expo-router", () => ({
+  Redirect: ({ href }: { href: unknown }) => {
+    state.href = href;
+    return null;
+  },
+}));
+vi.mock("@/navigation/host-route-context", () => ({ useHostRouteServerId: () => "host" }));
+vi.mock("@/screens/startup-splash-screen", () => ({ StartupSplashScreen: () => null }));
+vi.mock("@/stores/session-store-hooks", () => ({
+  useHasHydratedWorkspaces: () => true,
+  useWorkspaceExists: () => state.exists,
+}));
+vi.mock("@/stores/navigation-active-workspace-store", () => ({
+  useIsLastWorkspaceSelectionHydrated: () => state.hydrated,
+  useLastWorkspaceSelection: () => state.selection,
+}));
+let root: Root;
+let dom: JSDOM;
+beforeEach(() => {
+  dom = new JSDOM("<div id='root'></div>");
+  vi.stubGlobal("window", dom.window);
+  vi.stubGlobal("document", dom.window.document);
+  vi.stubGlobal("React", React);
+  vi.stubGlobal("IS_REACT_ACT_ENVIRONMENT", true);
+  vi.stubGlobal("__vibesPaseoEnvironment", {});
+  state.selection = null;
+  state.hydrated = true;
+  state.exists = true;
+  state.href = null;
+  root = createRoot(document.getElementById("root")!);
+});
+afterEach(() => {
+  act(() => root.unmount());
+  dom.window.close();
+  vi.unstubAllGlobals();
+});
+it("waits for native selection hydration before deciding whether this is the first launch", () => {
+  state.hydrated = false;
+  act(() => root.render(<HostIndexRoute />));
+  expect(state.href).toBeNull();
+  state.hydrated = true;
+  act(() => root.render(<HostIndexRoute />));
+  expect(state.href).toEqual({ pathname: "/vibes-chat", params: { serverId: "host" } });
+});
+it("restores the current native workspace and ignores the removed Chat/Build preference", () => {
+  state.selection = { serverId: "host", workspaceId: "chosen-project" };
+  act(() => root.render(<HostIndexRoute />));
+  expect(state.href).toEqual("/h/host/workspace/chosen-project");
+});
+it("lets the native resolver handle missing previous workspaces without preparing a different default", () => {
+  state.selection = { serverId: "host", workspaceId: "removed-project" };
+  state.exists = false;
+  act(() => root.render(<HostIndexRoute />));
+  expect(state.href).toEqual("/open-project");
+});
+it("keeps standalone Paseo on its original first-launch project picker", () => {
+  vi.stubGlobal("__vibesPaseoEnvironment", undefined);
+  act(() => root.render(<HostIndexRoute />));
+  expect(state.href).toEqual("/open-project");
+});
