+import { describe, expect, it } from "vitest";
+import type { WorkspaceTab } from "@/workspace-tabs/model";
+import { selectCompactConversation } from "./conversation-selection";
+
+const tabs: WorkspaceTab[] = [
+  { tabId: "older-agent", createdAt: 1, target: { kind: "agent", agentId: "agent-a" } },
+  { tabId: "draft", createdAt: 2, target: { kind: "draft", draftId: "unsent" } },
+  { tabId: "new-agent", createdAt: 3, target: { kind: "agent", agentId: "agent-b" } },
+  {
+    tabId: "file",
+    createdAt: 4,
+    target: { kind: "file", path: "README.md" },
+    state: { editor: "unsaved" },
+  },
+  { tabId: "terminal", createdAt: 5, target: { kind: "terminal", terminalId: "running-shell" } },
+];
+
+describe("compact conversation selection", () => {
+  it("keeps the active native conversation even when another conversation was remembered", () => {
+    expect(
+      selectCompactConversation({
+        tabs,
+        activeTabId: "draft",
+        lastConversationTabId: "older-agent",
+      }),
+    ).toBe("draft");
+  });
+  it("returns to the last conversation without mutating file edits or terminal targets", () => {
+    const before = structuredClone(tabs);
+    expect(
+      selectCompactConversation({
+        tabs,
+        activeTabId: "file",
+        lastConversationTabId: "older-agent",
+      }),
+    ).toBe("older-agent");
+    expect(
+      selectCompactConversation({ tabs, activeTabId: "terminal", lastConversationTabId: "draft" }),
+    ).toBe("draft");
+    expect(tabs).toEqual(before);
+  });
+  it("ignores closed remembered tabs and selects the newest remaining conversation", () => {
+    expect(
+      selectCompactConversation({ tabs, activeTabId: "file", lastConversationTabId: "closed-tab" }),
+    ).toBe("new-agent");
+  });
+  it("requests a native draft only when this workspace has no agent or draft", () => {
+    expect(
+      selectCompactConversation({
+        tabs: tabs.slice(3),
+        activeTabId: "file",
+        lastConversationTabId: "foreign-workspace-agent",
+      }),
+    ).toBeNull();
+  });
+});
