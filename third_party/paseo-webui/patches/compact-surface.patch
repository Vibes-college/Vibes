+    },
+  );
+
+  it("cancels pending audio startup before releasing the microphone for a new recording", async () => {
+    const audioReady = deferred<void>();
+    mock.audioStart.mockReturnValueOnce(audioReady.promise);
+    let first!: Promise<void>;
+    await act(async () => {
+      first = latest.startDictation();
+    });
+    expect(latest.status).toBe("recording");
+    expect(latest.isRecording).toBe(false);
+    let cancelled = false;
+    const markCancelled = () => {
+      cancelled = true;
+      return undefined;
+    };
+    let cancellation!: Promise<void>;
+    await act(async () => {
+      cancellation = latest.cancelDictation().then(markCancelled);
+    });
+    expect(cancelled).toBe(false);
+    await act(async () => {
+      audioReady.resolve();
+      await Promise.all([first, cancellation]);
+    });
+    expect(mock.audioStop).toHaveBeenCalledOnce();
+    expect(mock.restartStream).not.toHaveBeenCalled();
+    expect(latest.status).toBe("idle");
+    expect(latest.isRecording).toBe(false);
+    await record();
+    expect(mock.audioStart).toHaveBeenCalledTimes(2);
+    expect(mock.restartStream).toHaveBeenCalledOnce();
+    expect(options.onError).not.toHaveBeenCalled();
+  });
+
+  it("discards the cancelled audio graph's final buffered segment before a new recording", async () => {
+    await record();
+    mock.audioStop.mockImplementationOnce(async () => {
+      mock.audioConfig!.onPcmSegment("cancelled-tail");
+    });
+    await act(async () => {
+      await latest.cancelDictation();
+    });
+    expect(mock.enqueueSegment).not.toHaveBeenCalled();
+    await record();
+    act(() => mock.audioConfig!.onPcmSegment("new-recording"));
+    expect(mock.enqueueSegment).toHaveBeenCalledExactlyOnceWith("new-recording");
+  });
+
+  it("confirms one transcript when send is pressed twice before the first await", async () => {
+    await record();
+    const result = deferred<{ text: string }>();
+    mock.finish.mockReturnValue(result.promise);
+    let first!: Promise<void>;
+    await act(async () => {
+      first = latest.confirmDictation();
+      await latest.confirmDictation();
+    });
+    expect(mock.finish).toHaveBeenCalledOnce();
+    expect(latest.isProcessing).toBe(true);
+    await act(async () => {
+      result.resolve({ text: "hello" });
+      await first;
+    });
+    expect(options.onTranscript).toHaveBeenCalledOnce();
+    expect(latest.status).toBe("idle");
+  });
+
+  it("replays a failed recording once on a double retry", async () => {
+    await failTranscription();
+    const result = deferred<{ text: string }>();
+    mock.finish.mockReturnValue(result.promise);
+    let retry!: Promise<void>;
+    await act(async () => {
+      retry = latest.retryFailedDictation();
+      await latest.retryFailedDictation();
+    });
+    expect(mock.resetStreamForReplay).toHaveBeenCalledOnce();
+    await act(async () => {
+      result.resolve({ text: "retried" });
+      await retry;
+    });
+    expect(options.onTranscript).toHaveBeenCalledExactlyOnceWith("retried", expect.any(Object));
+  });
+
+  it("discards a pending replay without delivering its late transcript", async () => {
+    await failTranscription();
+    const result = deferred<{ text: string }>();
+    mock.finish.mockReturnValue(result.promise);
+    let retry!: Promise<void>;
+    await act(async () => {
+      retry = latest.retryFailedDictation();
+    });
+    act(() => latest.discardFailedDictation());
+    await act(async () => {
+      result.resolve({ text: "must not send" });
+      await retry;
+    });
+    expect(options.onTranscript).not.toHaveBeenCalled();
+    expect(latest.status).toBe("idle");
+    expect(latest.isProcessing).toBe(false);
+  });
+
+  it("returns to idle when microphone permission is denied", async () => {
+    vi.spyOn(console, "error").mockImplementation(() => undefined);
+    const denied = new Error("Microphone permission denied");
+    mock.audioStart.mockRejectedValueOnce(denied);
+    await act(async () => {
+      await latest.startDictation();
+    });
+    expect(latest.status).toBe("idle");
+    expect(latest.isRecording).toBe(false);
+    expect(options.onError).toHaveBeenCalledWith(denied);
+    expect(options.onTranscript).not.toHaveBeenCalled();
+  });
+
+  it("does not submit an empty final transcript", async () => {
+    await record();
+    mock.finish.mockResolvedValueOnce({ text: "   " });
+    await act(async () => {
+      await latest.confirmDictation();
+    });
+    expect(options.onTranscript).not.toHaveBeenCalled();
+    expect(latest.status).toBe("idle");
+  });
+});
