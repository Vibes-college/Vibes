--- /dev/null
+++ b/packages/app/src/embedded/conversation-selection.ts
@@ -0,0 +1,22 @@
+import type { WorkspaceTab } from "@/workspace-tabs/model";
+
+export function isConversationTab(tab: WorkspaceTab | null | undefined): boolean {
+  return tab?.target.kind === "agent" || tab?.target.kind === "draft";
+}
+
+/** Select an existing native tab without moving, closing or recreating any pane. */
+export function selectCompactConversation(input: {
+  tabs: readonly WorkspaceTab[];
+  activeTabId: string | null;
+  lastConversationTabId: string | null;
+}): string | null {
+  const active = input.tabs.find((tab) => tab.tabId === input.activeTabId);
+  if (isConversationTab(active)) return active!.tabId;
+  const previous = input.tabs.find((tab) => tab.tabId === input.lastConversationTabId);
+  if (isConversationTab(previous)) return previous!.tabId;
+  let newest: WorkspaceTab | null = null;
+  for (const tab of input.tabs) {
+    if (isConversationTab(tab) && (!newest || tab.createdAt > newest.createdAt)) newest = tab;
+  }
+  return newest?.tabId ?? null;
+}
