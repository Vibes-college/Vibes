@@ -0,0 +1,100 @@
+import { useLayoutEffect, type CSSProperties } from "react";
+import { createPortal } from "react-dom";
+import { usePathname } from "expo-router";
+import { useTranslation } from "react-i18next";
+import { useIsCompactFormFactor } from "@/constants/layout";
+import { useKeyboardActionDispatcher } from "@/keyboard/keyboard-action-dispatcher-context";
+import { useLastWorkspaceSelection } from "@/stores/navigation-active-workspace-store";
+import { selectIsAgentListOpen, usePanelStore } from "@/stores/panel-store";
+import { navigateToHostWorkspaceRoute } from "@/navigation/workspace-route-navigation";
+import { buildHostWorkspaceRoute } from "@/utils/host-routes";
+import { parseHostWorkspaceRouteFromPathname } from "@/utils/host-routes";
+import { getEmbeddedHost } from "./environment";
+import { useEmbeddedSurface } from "./use-embedded-surface";
+
+const buttonStyle: CSSProperties = {
+  height: 44,
+  width: 44,
+  padding: 0,
+  display: "inline-flex",
+  alignItems: "center",
+  justifyContent: "center",
+  border: 0,
+  borderRadius: 0,
+  background: "transparent",
+  color: "#111827",
+  cursor: "pointer",
+  flexShrink: 0,
+  touchAction: "manipulation",
+};
+
+/** React owns the action; the host supplies only an explicit presentation slot. */
+export function EmbeddedToolbar() {
+  const host = getEmbeddedHost();
+  const surface = useEmbeddedSurface();
+  const compactLayout = useIsCompactFormFactor();
+  const pathname = usePathname();
+  const { t, i18n } = useTranslation();
+  const dispatcher = useKeyboardActionDispatcher();
+  const selection = useLastWorkspaceSelection();
+  const isWorkspace = parseHostWorkspaceRouteFromPathname(pathname) !== null;
+  const menuOpen = usePanelStore((state) =>
+    selectIsAgentListOpen(state, { isCompact: compactLayout }),
+  );
+  const toggleMenu = usePanelStore((state) => state.toggleAgentListForLayout);
+  const showMobileAgent = usePanelStore((state) => state.showMobileAgent);
+
+  useLayoutEffect(() => {
+    if (surface !== "compact") return;
+    showMobileAgent();
+    // Setup can be needed before a first conversation exists. Existing workspaces
+    // return through their native route; no conversation or file state is copied.
+    if (
+      isWorkspace ||
+      pathname === "/" ||
+      pathname === "/vibes-chat" ||
+      pathname === "/welcome" ||
+      pathname.startsWith("/pair-scan") ||
+      /^\/h\/[^/]+\/?$/.test(pathname)
+    )
+      return;
+    if (selection)
+      navigateToHostWorkspaceRoute(
+        buildHostWorkspaceRoute(selection.serverId, selection.workspaceId),
+      );
+    else host?.onEvent({ version: 1, type: "surface", value: "full" });
+  }, [surface, pathname, isWorkspace, selection, showMobileAgent, host]);
+
+  if (!host?.toolbarRoot || !surface) return null;
+  const isCompact = surface === "compact";
+  const label = isCompact
+    ? i18n.language.startsWith("zh")
+      ? "新对话"
+      : "New conversation"
+    : t(menuOpen ? "shell.menu.close" : "shell.menu.open");
+  return createPortal(
+    <button
+      type="button"
+      data-testid={isCompact ? "embedded-new-conversation" : "menu-button"}
+      aria-label={label}
+      title={label}
+      aria-expanded={isCompact ? undefined : menuOpen}
+      style={buttonStyle}
+      disabled={isCompact && !isWorkspace}
+      onClick={() => {
+        if (isCompact) dispatcher.dispatch({ id: "workspace.agent.new", scope: "workspace" });
+        else toggleMenu({ isCompact: compactLayout });
+      }}
+    >
+      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
+        <path
+          d={isCompact ? "M12 5v14M5 12h14" : "M5 6h14M5 12h14M5 18h9"}
+          stroke="currentColor"
+          strokeWidth="1.5"
+          strokeLinecap="round"
+        />
+      </svg>
+    </button>,
+    host.toolbarRoot,
+  );
+}
