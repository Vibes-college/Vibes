@@ -0,0 +1,64 @@
+import { useSyncExternalStore } from "react";
+import { getEmbeddedHost } from "@/embedded/environment";
+
+function subscribe(listener: () => void): () => void {
+  return getEmbeddedHost()?.subscribe(listener) ?? (() => undefined);
+}
+
+function getSnapshot(): boolean {
+  return getEmbeddedHost()?.surface === "compact";
+}
+
+/** A desktop compact panel has the same input behavior as a phone panel. */
+export function useEmbeddedCompactSurface(): boolean {
+  return useSyncExternalStore(subscribe, getSnapshot, () => false);
+}
+
+export function resolveCompactVoiceMode(input: {
+  embeddedCompact: boolean;
+  showVoice: boolean;
+  readOnly: boolean;
+  autoFocus: boolean;
+}) {
+  const enabled = input.embeddedCompact && input.showVoice && !input.readOnly;
+  return {
+    enabled,
+    autoFocus: input.autoFocus && !enabled,
+    showSeparateVoice: input.showVoice && !enabled,
+  };
+}
+
+export function resolveCompactDictationPresentation(input: {
+  enabled: boolean;
+  status: string;
+  isRecording: boolean;
+  isProcessing: boolean;
+}) {
+  const starting = input.enabled && input.status === "recording" && !input.isRecording;
+  return {
+    isRecording: input.isRecording || starting,
+    isProcessing: input.isProcessing || starting,
+  };
+}
+
+export function resolveCompactInputControls(input: {
+  enabled: boolean;
+  hasText: boolean;
+  hasSendableContent: boolean;
+  allowEmptySubmit: boolean;
+  isSubmitLoading: boolean;
+  isSendButtonDisabled: boolean;
+}) {
+  const compactSend = input.enabled && input.hasText;
+  return {
+    showVoice: input.enabled && !input.hasText,
+    showSend: input.enabled ? input.hasText : input.hasSendableContent,
+    allowEmptySubmit: !input.enabled && input.allowEmptySubmit,
+    sendDisabled:
+      input.isSendButtonDisabled ||
+      (compactSend &&
+        !input.hasSendableContent &&
+        !input.allowEmptySubmit &&
+        !input.isSubmitLoading),
+  };
+}
