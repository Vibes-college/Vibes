@@ -0,0 +1,53 @@
+import type { ProviderSnapshotEntry } from "@getpaseo/protocol/agent-types";
+import {
+  mergeProviderPreferences,
+  type FormPreferences,
+} from "@/create-agent-preferences/preferences";
+import type {
+  FormInitialValues,
+  UserModifiedFields,
+} from "@/provider-selection/resolve-agent-form";
+import { ChatPresetError, resolveChatSetup } from "./chat-preset";
+import { getEmbeddedHost } from "./environment";
+
+/** Supply a default to the native form resolver, without persisting a second preference. */
+export function resolveEmbeddedFormPreferences(input: {
+  preferences: FormPreferences;
+  initialValues: FormInitialValues | undefined;
+  userModified: UserModifiedFields;
+  entries: ProviderSnapshotEntry[];
+  loading: boolean;
+  cwd: string;
+}): FormPreferences | null {
+  const fields = ["provider", "model", "modeId", "thinkingOptionId"] as const;
+  if (
+    !getEmbeddedHost() ||
+    fields.some(
+      (field) => input.initialValues?.[field] !== undefined || input.userModified[field],
+    ) ||
+    input.preferences.provider !== undefined ||
+    Object.keys(input.preferences.providerPreferences ?? {}).length > 0
+  ) {
+    return input.preferences;
+  }
+  if (input.loading && !input.entries.some((entry) => entry.provider === "codex")) return null;
+  try {
+    const setup = resolveChatSetup(input.entries, input.cwd);
+    if (!setup) return null;
+    return mergeProviderPreferences({
+      preferences: input.preferences,
+      provider: setup.provider,
+      updates: {
+        model: setup.model ?? undefined,
+        mode: setup.modeId ?? undefined,
+        ...(setup.model && setup.thinkingOptionId
+          ? { thinkingByModel: { [setup.model]: setup.thinkingOptionId } }
+          : {}),
+      },
+    });
+  } catch (error) {
+    // Missing Codex/Luna keeps the official model picker available.
+    if (error instanceof ChatPresetError) return input.preferences;
+    throw error;
+  }
+}
