diff --git a/packages/app/src/embedded/environment.ts b/packages/app/src/embedded/environment.ts
new file mode 100644
--- /dev/null
+++ b/packages/app/src/embedded/environment.ts
@@ -0,0 +1,16 @@
+export interface EmbeddedHost {
+  readonly root: HTMLElement;
+  readonly width: number;
+  readonly height: number;
+  readonly visible: boolean;
+  subscribe(listener: () => void): () => void;
+}
+
+declare global {
+  var __vibesPaseoEnvironment: EmbeddedHost | undefined;
+}
+
+// Only the separately built embedding profile installs this host boundary.
+export function getEmbeddedHost(): EmbeddedHost | undefined {
+  return globalThis.__vibesPaseoEnvironment;
+}
