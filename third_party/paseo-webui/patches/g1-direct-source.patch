+    instance = AppRegistry.runApplication("VibesPaseo", { rootTag: element });
+    return instance;
+  },
+  presentation(visible: boolean) {
+    if (!mounted) throw new Error("Paseo is not mounted");
+    mounted.hidden = !visible;
+  },
+  get mounted() { return Boolean(mounted); },
+  get mountCount() { return mountCount; },
+};
+Object.defineProperty(globalThis, "__vibesPaseo", { value: api });
+window.dispatchEvent(new Event("vibes:paseo-module-ready"));
