---
import Explore from '../../../components/Explore.astro';
import { getBrowsePages } from '../../../data/works';
import { locales } from '../../../lib/i18n/routes';
export function getStaticPaths() {
  return locales.flatMap((locale) =>
    getBrowsePages(locale)
      .filter((page) => !page.tag && page.page > 1)
      .map((page) => ({ params: { locale, page: String(page.page) }, props: { page } })),
  );
}
const { page } = Astro.props;
---

<Explore page={page} />
