---
import MdxHeading from '../../../components/MdxHeading.astro';
import { escapeHtml } from '../../../lib/preview';
import { getEntry, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import WorkDetail from '../../../components/WorkDetail.astro';
import SectionReaction from '../../../components/SectionReaction.astro';
import '../../../styles/section-reactions.css';
import 'virtual:prose-ui.css';
import '../../../styles/prose.css';
import '@prose-ui/style/katex.css';
import ReadingProgress from '../../../components/ReadingProgress.astro';
import { catalog, getWorks } from '../../../data/works';
import { articleSections } from '../../../data/article-sections';
import { validateFactAnchors } from '../../../data/work-facts';
import { locales, htmlLanguages, workPath } from '../../../lib/i18n/routes';
import { languageTarget } from '../../../lib/content/views';
import { createPublicWorkDraft } from '../../../features/paseo-webui/page-context';
import { buildSite } from '../../../config/site';
export function getStaticPaths() {
  return locales.flatMap((locale) =>
    getWorks(locale).map((work) => ({ params: { locale, id: work.slug }, props: { work } })),
  );
}
const { work } = Astro.props;
const entry = await getEntry('workVersions', `${work.slug}/${work.locale}`);
if (!entry) throw new Error(`Missing article: ${work.slug}/${work.locale}`);
const isMdx = catalog.works
  .find((item) => item.meta.id === work.slug)
  ?.versions[work.locale]?.file.endsWith('.mdx');
if (!isMdx && !entry.rendered?.html)
  throw new Error(`Missing rendered article: ${work.slug}/${work.locale}`);
const rendered = isMdx ? await render(entry) : undefined;
const Content = rendered?.Content;
const metadata = rendered?.remarkPluginFrontmatter;
const sections = isMdx
  ? (metadata?.articleHeadings as { id: string; title: string }[]).map(({ id, title }) => ({
      heading: `<h2 id="${escapeHtml(id)}">${escapeHtml(title)}</h2>`,
      body: '',
    }))
  : articleSections(entry.rendered?.html ?? '');
validateFactAnchors(
  work,
  isMdx
    ? (metadata?.articleAnchors as string[]).map((id) => `id="${escapeHtml(id)}"`).join(' ')
    : (entry.rendered?.html ?? ''),
);
const alternates = locales.flatMap((locale) => {
  const target = languageTarget(catalog, work.slug, locale);
  return target?.href ? [{ locale: htmlLanguages[locale], path: target.href }] : [];
});
---

<Layout
  detail
  locale={work.locale}
  title={`${work.title} — Vibes`}
  description={work.summary}
  alternates={alternates}
  defaultPath={workPath(work.originalLocale, work.slug)}
  publicWork={createPublicWorkDraft(
    work,
    new URL(workPath(work.locale, work.slug), buildSite().origin).href,
  )}
>
  <main
    id="main"
    class="detail-page"
    data-locale={work.locale}
    data-article-format={isMdx ? 'mdx' : 'md'}
  >
    <article lang={htmlLanguages[work.locale]} data-pagefind-body>
      <WorkDetail work={work}>
        {
          Content ? (
            <Content components={{ h2: MdxHeading }} />
          ) : (
            sections.map((section) =>
              section.heading ? (
                <section class="reading-section">
                  <SectionReaction heading={section.heading} locale={work.locale} />
                  <div class="section-content">
                    <Fragment set:html={section.body} />
                  </div>
                </section>
              ) : (
                <Fragment set:html={section.body} />
              ),
            )
          )
        }
      </WorkDetail>
    </article>
    <ReadingProgress sections={sections} locale={work.locale} />
  </main>
</Layout>

<script src="../../../scripts/prose.ts"></script>
