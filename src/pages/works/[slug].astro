---
import Layout from '../../layouts/Layout.astro';
import WorkDetail from '../../components/WorkDetail.astro';
import { works } from '../../data/works';
import type { MarkdownInstance } from 'astro';
const articles = import.meta.glob<MarkdownInstance<{ readingTitle: string }>>(
  '../../content/articles/*.md',
  { eager: true },
);
// 为每条作品生成静态详情页。
export function getStaticPaths() {
  return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}
const { work } = Astro.props;
const article = articles[`../../content/articles/${work.slug}.md`];
if (!article) throw new Error(`Missing article: ${work.slug}`);
const { Content } = article;
---

<Layout title={`${work.title} — Vibes`} description={work.summary}>
  <main id="main" class="detail-page">
    <a class="back-link" href="/explore/">← Explore</a><article lang="zh-CN">
      <WorkDetail work={work}><Content /></WorkDetail>
    </article>
  </main>
</Layout>
