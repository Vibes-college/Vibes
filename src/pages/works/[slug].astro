---
import LegacyRedirect from '../../components/LegacyRedirect.astro';
import { catalog } from '../../data/works';
import { workPath } from '../../lib/i18n/routes';
export function getStaticPaths() {
  return catalog.works
    .filter((work) => work.versions[work.meta.originalLocale]?.data.status === 'published')
    .map((work) => ({
      params: { slug: work.meta.id },
      props: { target: workPath(work.meta.originalLocale, work.meta.id) },
    }));
}
const { target } = Astro.props;
---

<LegacyRedirect target={target} />
