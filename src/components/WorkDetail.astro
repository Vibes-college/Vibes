---
import Preview from './Preview.astro';
import { works, workPath, type Work } from '../data/works';
import { workFacts } from '../data/work-facts';
interface Props {
  work: Work;
}
const { work } = Astro.props;
const index = works.findIndex((entry) => entry.slug === work.slug);
const previous = works[index - 1];
const next = works[index + 1];
const source = new URL(work.url);
---

<section class="detail-cover" aria-label="作品概览" data-work-detail>
  <a class="original-site" href={work.url} target="_blank" rel="noopener noreferrer">
    <span>{source.hostname}</span>
    <img src="/icons/external-link.svg" width="18" height="18" alt="" />
    <span class="sr-only">前往原始作品（在新标签页打开）</span>
  </a>
  <a
    class="detail-preview"
    href={work.url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`打开原站体验：${work.title}（新标签页）`}
  >
    <Preview work={work} />
  </a>
  <header class="article-header">
    <h1>{work.title}</h1>
    <p class="detail-description">{work.description}</p>
    <dl class="work-facts">
      {
        workFacts(work).map((fact) => (
          <div>
            <>
              <dt>{fact.label}</dt>
              <dd>
                <a href={fact.href}>{fact.value}</a>
              </dd>
            </>
          </div>
        ))
      }
    </dl>
  </header>
  <nav class="detail-navigation" aria-label="作品切换">
    <a class="back-link" href="/explore/">← Explore</a>
    <a class="read-down" href="#reading" aria-label="向下阅读正文"
      ><img src="/icons/chevron-down.svg" width="20" height="20" alt="" /></a
    >
    <div class="work-pagination">
      {
        previous ? (
          <a
            data-direction="previous"
            href={workPath(previous.slug)}
            aria-label={`上一个作品：${previous.title}`}
          >
            <img
              class="previous-icon"
              src="/icons/chevron-down.svg"
              width="18"
              height="18"
              alt=""
            />
          </a>
        ) : (
          <span class="disabled-direction" aria-label="已经是第一个作品">
            <img
              class="previous-icon"
              src="/icons/chevron-down.svg"
              width="18"
              height="18"
              alt=""
            />
          </span>
        )
      }
      {
        next ? (
          <a
            data-direction="next"
            href={workPath(next.slug)}
            aria-label={`下一个作品：${next.title}`}
          >
            <img class="next-icon" src="/icons/chevron-down.svg" width="18" height="18" alt="" />
          </a>
        ) : (
          <span class="disabled-direction" aria-label="已经是最后一个作品">
            <img class="next-icon" src="/icons/chevron-down.svg" width="18" height="18" alt="" />
          </span>
        )
      }
    </div>
  </nav>
</section>
<section id="reading" class="reading-page" aria-label="作品正文" tabindex="-1">
  <p class="reading-note">深入了解 <span>选择一个章节，展开阅读</span></p>
  <div class="prose" lang="zh-CN"><slot /></div>
  <a class="source-link" href={work.url} target="_blank" rel="noopener noreferrer"
    >前往原始作品 ↗<span class="sr-only">（在新标签页打开）</span></a
  >
</section>
<script src="../scripts/detail.ts"></script>
