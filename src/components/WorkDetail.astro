---
import Preview from './Preview.astro';
import { catalog, getWorks, type Work } from '../data/works';
import { workFacts } from '../data/work-facts';
import { adjacentWorks } from '../lib/content/views';
import { messages } from '../lib/i18n/messages';
import { browsePath, workPath, htmlLanguages } from '../lib/i18n/routes';
interface Props {
  work: Work;
}
const { work } = Astro.props;
const { previous, next } = adjacentWorks(getWorks(work.locale), work.slug);
const source = new URL(work.url);
const t = messages[work.locale];
const meta = {
  id: work.slug,
  type: work.type,
  title: work.title,
  summary: work.summary,
  preview: work.preview,
  color: work.color,
  eyebrow: work.eyebrow,
  display: work.display,
  note: work.note,
};
---

{
  Object.entries(meta).map(([key, value]) => (
    <meta data-pagefind-meta={`${key}[content]`} content={value} />
  ))
}
{
  [work.meta.typeId, ...work.meta.tagIds].map((tag) => (
    <meta data-pagefind-filter="tag[content]" content={tag} />
  ))
}

<section class="detail-cover" aria-label={t.overview} data-work-detail>
  <nav class="detail-navigation" aria-label={t.switchWork} data-pagefind-ignore>
    <a class="back-link" data-back-link href={browsePath(work.locale)} aria-label={t.explore}
      ><img src="/icons/x-mark.svg" width="22" height="22" alt="" /></a
    >
    <div class="work-pagination">
      {
        previous ? (
          <a
            data-direction="previous"
            href={workPath(work.locale, previous.slug)}
            aria-label={`${t.previousWork}：${previous.title}`}
          >
            <img
              class="previous-icon"
              src="/icons/chevron-down.svg"
              width="18"
              height="18"
              alt=""
            />
          </a>
        ) : (
          <span class="disabled-direction" aria-label={t.firstWork}>
            <img
              class="previous-icon"
              src="/icons/chevron-down.svg"
              width="18"
              height="18"
              alt=""
            />
          </span>
        )
      }
      {
        next ? (
          <a
            data-direction="next"
            href={workPath(work.locale, next.slug)}
            aria-label={`${t.nextWork}：${next.title}`}
          >
            <img class="next-icon" src="/icons/chevron-down.svg" width="18" height="18" alt="" />
          </a>
        ) : (
          <span class="disabled-direction" aria-label={t.lastWork}>
            <img class="next-icon" src="/icons/chevron-down.svg" width="18" height="18" alt="" />
          </span>
        )
      }
    </div>
  </nav>
  <div class="detail-source-row" data-pagefind-ignore>
    <a class="original-site" href={work.url} target="_blank" rel="noopener noreferrer"
      ><span>{source.hostname}</span><img
        src="/icons/external-link.svg"
        width="18"
        height="18"
        alt=""
      /><span class="sr-only">{t.source}（{t.external}）</span></a
    >
  </div>
  <a
    class="detail-preview"
    href={work.url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${t.experience}：${work.title}（${t.external}）`}
    data-pagefind-ignore><Preview work={work} /></a
  >
  <header class="article-header">
    <h1 data-pagefind-meta="title">{work.title}</h1>
    <p class="detail-description">{work.description}</p>
    {
      work.needsReview && (
        <p class="translation-notice" data-pagefind-ignore>
          {t.stale}
        </p>
      )
    }
    <dl class="work-facts">
      {
        workFacts(work, catalog).map((fact) => (
          <div>
            <>
              <dt>{fact.label}</dt>
              <dd>
                {fact.href ? (
                  <a
                    href={fact.href}
                    target={fact.external ? '_blank' : undefined}
                    rel={fact.external ? 'noopener noreferrer' : undefined}
                  >
                    {fact.value}
                  </a>
                ) : (
                  <span>{fact.value}</span>
                )}
                {fact.fallbackLocale && (
                  <small class="fact-fallback" lang={htmlLanguages[work.locale]}>
                    （{t.originalFact}）
                  </small>
                )}
              </dd>
            </>
          </div>
        ))
      }
    </dl>
    <span class="sr-only"
      >{
        catalog.taxonomy
          .filter((tag) => work.meta.typeId === tag.id || work.meta.tagIds.includes(tag.id))
          .map((tag) => [tag.labels[work.locale], ...tag.aliases[work.locale]].join(' '))
          .join(' ')
      }</span
    >
  </header>
  <div class="detail-bottom" data-pagefind-ignore>
    <a class="read-down" href="#reading" aria-label={t.readDown}
      ><img src="/icons/chevron-down.svg" width="20" height="20" alt="" /></a
    >
  </div>
</section>
<div class="edge-navigation" aria-hidden="true" data-pagefind-ignore>
  <img src="/icons/chevron-down.svg" width="22" height="22" alt="" />
</div>
<section id="reading" class="reading-page" aria-label={t.body} tabindex="-1">
  <div class="prose" lang={htmlLanguages[work.locale]}><slot /></div>
</section>
<script src="../scripts/detail.ts"></script>
