---
import ReactionButton from './ReactionButton.astro';
interface Props {
  heading: string;
  locale: string;
}
const { heading, locale } = Astro.props;
const id = heading.match(/\bid="([^"]+)"/)?.[1];
---

<div class="chapter-heading">
  <Fragment set:html={heading} />
  <ReactionButton id={id} locale={locale} />
</div>
