---
import '../styles/global.css';
import LocalAssistant from '../components/LocalAssistant.astro';
import { getPaseoBuild } from '../features/paseo-webui/build-config';
import type { PublicWorkDraft } from '../features/paseo-webui/contract';
import { ClientRouter } from 'astro:transitions';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import { messages } from '../lib/i18n/messages';
import { browsePath, htmlLanguages, type Locale } from '../lib/i18n/routes';
import { buildSite } from '../config/site';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  search?: boolean;
  detail?: boolean;
  locale?: Locale;
  alternates?: { locale: string; path: string }[];
  defaultPath?: string;
  publicWork?: PublicWorkDraft | null;
}
const {
  locale = 'zh',
  title = 'Explore — Vibes',
  description,
  noindex = false,
  search = false,
  detail = false,
  alternates = [],
  defaultPath,
  publicWork,
} = Astro.props;
const t = messages[locale];
const site = buildSite();
const canonical = new URL(Astro.url.pathname, site.origin);
const summary = description || t.footer;
const paseo = getPaseoBuild();
---

<!doctype html>
<html lang={htmlLanguages[locale]} transition:animate="none">
  <head>
    <ClientRouter fallback="swap" />
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={summary} />
    <link rel="canonical" href={canonical} /><link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    {
      alternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.locale}
          href={new URL(alternate.path, site.origin)}
        />
      ))
    }
    {
      defaultPath && (
        <link rel="alternate" hreflang="x-default" href={new URL(defaultPath, site.origin)} />
      )
    }
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={title} /><meta property="og:description" content={summary} />
    <meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body class:list={{ 'is-detail': detail }}>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header" data-pagefind-ignore>
      <a class="wordmark" href={browsePath(locale)} aria-label={t.home}
        >vibes<span aria-hidden="true">.</span></a
      >
      {
        search ? (
          <form class="search" role="search" action={browsePath(locale)}>
            <label class="sr-only" for="search">
              {t.search}
            </label>
            <input
              id="search"
              type="search"
              name="q"
              placeholder={t.search}
              autocomplete="off"
              maxlength="160"
            />
            <button class="search-clear" type="reset" aria-label={t.clear} hidden>
              ×
            </button>
          </form>
        ) : (
          <a class="header-explore" href={browsePath(locale)}>
            {t.explore}
          </a>
        )
      }
      {!detail && <LanguageSwitch locale={locale} />}
      <span class="header-note">{t.campus}</span>
    </header>
    <slot />
    {paseo && <LocalAssistant config={paseo.config} locale={locale} />}
    {paseo && publicWork && <div hidden data-paseo-public-work={JSON.stringify(publicWork)} />}
    <script>
      import '../scripts/reading-prefetch';
      import '../scripts/media-boot';
    </script>
    <footer class="site-footer" data-pagefind-ignore transition:persist={`footer-${locale}`}>
      <span>{t.footer}</span><a href="#main">{t.top}</a>
    </footer>
  </body>
</html>
